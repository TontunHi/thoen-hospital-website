# ============================================================
# Thoen Hospital Website — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ── Primary Application Database (Prisma & Member System) ──
# Shared between Prisma ORM and member modules.
# When MEMBER_DB_* are omitted, memberDb automatically parses DATABASE_URL.
DATABASE_URL="mysql://your_db_user:your_db_password@your_db_host:3306/your_db_name?charset=utf8mb4"

# Optional explicit member DB overrides (leave blank to inherit from DATABASE_URL)
MEMBER_DB_HOST=""
MEMBER_DB_PORT=""
MEMBER_DB_USER=""
MEMBER_DB_PASSWORD=""
MEMBER_DB_NAME=""

# ── HOSxP Clinical Database (Read-only) ──
# Unified connection for Hospital Information System (ER, Appointments, Wards, Labs).
# Legacy APPOINT_DB_* and ER_DB_* are supported as fallbacks.
HOSXP_DB_HOST="your_hosxp_db_host"
HOSXP_DB_PORT="3306"
HOSXP_DB_USER="guest"
HOSXP_DB_PASSWORD="guest"
HOSXP_DB_NAME="hos"
HOSXP_DB_CHARSET="tis620"

# ── Salary Database (Read-only for slips, Edit pool for finance uploads) ──
SALARY_DB_HOST="your_salary_db_host"
SALARY_DB_PORT="3306"
SALARY_DB_USER="guest"
SALARY_DB_PASSWORD="guest"
SALARY_DB_NAME="salary"
SALARY_DB_CHARSET="tis620"

SALARY_EDIT_DB_HOST="your_salary_db_host"
SALARY_EDIT_DB_PORT="3306"
SALARY_EDIT_DB_USER="salary_writer"
SALARY_EDIT_DB_PASSWORD="your_writer_password"
SALARY_EDIT_DB_NAME="salary"
SALARY_EDIT_DB_CHARSET="tis620"

# ── Authentication & Security Secrets ──
MEMBER_SESSION_SECRET="placeholder_member_secret_minimum_32_characters"
CRON_SECRET="placeholder_cron_secret_minimum_32_characters"
COOKIE_SECURE="false"

# ── Email & Notification Services ──
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your_brevo_login"
BREVO_SMTP_PASS="your_brevo_smtp_key"
BREVO_SMTP_FROM_EMAIL="your_email@example.com"
BREVO_SMTP_FROM='"ระบบสมาชิก โรงพยาบาลเถิน" <your_email@example.com>'

MEMBER_OTP_EMAIL_USER="your_email@example.com"
MEMBER_OTP_EMAIL_PASS="your_smtp_app_password"
MEMBER_OTP_EMAIL_FROM='"ระบบสมาชิก โรงพยาบาลเถิน" <web.thoenhp@gmail.com>'

# ── Telegram Bot Integration ──
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="ThoenHospitalBot"
TELEGRAM_WEBHOOK_SECRET="placeholder_telegram_webhook_secret_minimum_32_chars"

# ── Site & Infrastructure ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BACKUP_NETWORK_PATH="\\\\192.168.130.2\\งาน it\\Pisut Yimkuson\\backups"
