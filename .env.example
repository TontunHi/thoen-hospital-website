# ============================================================
# Thoen Hospital Website — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ── Primary Database (Prisma) ──
# e.g. mysql://username:password@localhost:3306/db_name?charset=utf8mb4
DATABASE_URL="mysql://your_db_user:your_db_password@your_db_host:3306/your_db_name?charset=utf8mb4"

# ── Admin Session Secret ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="placeholder_admin_secret_minimum_32_characters"

# ── Salary Database (External, read-only) ──
SALARY_DB_HOST="your_salary_db_host"
SALARY_DB_PORT="3306"
SALARY_DB_USER="your_salary_db_user"
SALARY_DB_PASSWORD="your_salary_db_password"
SALARY_DB_NAME="your_salary_db_name"
SALARY_DB_CHARSET="tis620"

# ── OTP Email (Admin Login - Gmail App Password or SMTP) ──
OTP_EMAIL_USER="your_email@example.com"
OTP_EMAIL_PASS="your_smtp_app_password"
OTP_EMAIL_FROM='"โรงพยาบาลเถิน ระบบจัดการข่าวสาร" <your_email@example.com>'

# ── ER Database (HOSxP, read-only) ──
ER_DB_HOST="your_er_db_host"
ER_DB_PORT="3306"
ER_DB_USER="your_er_db_user"
ER_DB_PASSWORD="your_er_db_password"
ER_DB_NAME="your_er_db_name"
ER_DB_CHARSET="tis620"

# ── Appointment Database (HOSxP, read-only) ──
APPOINT_DB_HOST="your_appointment_db_host"
APPOINT_DB_PORT="3306"
APPOINT_DB_USER="your_appointment_db_user"
APPOINT_DB_PASSWORD="your_appointment_db_password"
APPOINT_DB_NAME="your_appointment_db_name"
APPOINT_DB_CHARSET="tis620"

# ── Member System Database ──
MEMBER_DB_HOST="your_member_db_host"
MEMBER_DB_PORT="3306"
MEMBER_DB_USER="your_member_db_user"
MEMBER_DB_PASSWORD="your_member_db_password"
MEMBER_DB_NAME="your_member_db_name"

# ── Member OTP Email (Gmail App Password or SMTP) ──
MEMBER_OTP_EMAIL_USER="your_email@example.com"
MEMBER_OTP_EMAIL_PASS="your_smtp_app_password"
MEMBER_OTP_EMAIL_FROM='"ระบบสมาชิก โรงพยาบาลเถิน" <your_email@example.com>'

# ── Member Session Secret ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBER_SESSION_SECRET="placeholder_member_secret_minimum_32_characters"

# ── NextAuth Configuration ──
NEXTAUTH_SECRET="placeholder_nextauth_secret_minimum_32_characters"
NEXTAUTH_URL="http://localhost:3000"
COOKIE_SECURE="false"
