# ============================================================
# Thoen Hospital Website — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ── Thoen Unified API Gateway (100% Zero-Database Architecture) ──
# All data access (HOSxP, Salary, Website CMS/Members) is routed through the Unified API Gateway.
# The web application does NOT maintain any direct database sockets or credentials.
API_GATEWAY_URL="http://192.168.1.208:8443"
API_GATEWAY_KEY="your_api_gateway_key_here"
API_GATEWAY_TIMEOUT_MS="10000"

# ── Authentication & Security Secrets ──
MEMBER_SESSION_SECRET="placeholder_member_secret_minimum_32_characters"
CRON_SECRET="placeholder_cron_secret_minimum_32_characters"
COOKIE_SECURE="false"

# ── Email & Notification Services ──
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your_brevo_login"
BREVO_SMTP_PASS="your_brevo_smtp_key"
BREVO_SMTP_FROM_EMAIL="your_email@example.com"
BREVO_SMTP_FROM='"ระบบสมาชิก โรงพยาบาลเถิน" <your_email@example.com>'

MEMBER_OTP_EMAIL_USER="your_email@example.com"
MEMBER_OTP_EMAIL_PASS="your_smtp_app_password"
MEMBER_OTP_EMAIL_FROM='"ระบบสมาชิก โรงพยาบาลเถิน" <web.thoenhp@gmail.com>'

# ── Telegram Bot Integration ──
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="ThoenHospitalBot"
TELEGRAM_WEBHOOK_SECRET="placeholder_telegram_webhook_secret_minimum_32_chars"
TELEGRAM_GROUP_MEDIA_REQUEST="-5235759439"
TELEGRAM_GROUP_IT_REPAIR="-5547296760"
TELEGRAM_GROUP_GENERAL_REPAIR="-5487353615"
TELEGRAM_GROUP_MEDICAL_REPAIR="-5477389393"
TELEGRAM_IPD_CHAT_ID="-5379877309"

# ── Site & Infrastructure ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BACKUP_NETWORK_PATH="\\\\192.168.130.2\\งาน it\\Pisut Yimkuson\\backups"

# ── ThaID OpenID Connect (DOPA) Integration ──
THAID_CLIENT_ID="your_thaid_client_id"
THAID_CLIENT_SECRET="your_thaid_client_secret"
THAID_API_KEY="your_thaid_api_key"
THAID_REDIRECT_URI="http://localhost:3000/api/auth/thaid/callback"

# ── Smart Card Reader Bridge ──
# Localhost Loopback Architecture: No secret required for local web scanning (127.0.0.1:8084).
# Optional: only required if deploying standalone unattended kiosks pushing across remote internet.
SMARTCARD_BRIDGE_SECRET=""

# ── Health ID & Provider ID (MOPH) Integration ──
PROVIDER_ID_ENV="PRD"
HEALTH_ID_CLIENT_ID="your_health_id_client_id"
HEALTH_ID_CLIENT_SECRET="your_health_id_client_secret"
PROVIDER_ID_CLIENT_ID="your_provider_id_client_id"
PROVIDER_ID_SECRET_KEY="your_provider_id_secret_key"
PROVIDER_ID_REDIRECT_URI="https://thlp.moph.go.th/api/auth/provider-id/callback"

# Optional UAT overrides
HEALTH_ID_UAT_CLIENT_ID="your_health_id_uat_client_id"
HEALTH_ID_UAT_CLIENT_SECRET="your_health_id_uat_client_secret"
PROVIDER_ID_UAT_CLIENT_ID="your_provider_id_uat_client_id"
PROVIDER_ID_UAT_SECRET_KEY="your_provider_id_uat_secret_key"
