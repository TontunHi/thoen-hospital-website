# ============================================================
# Thoen Hospital — Appointment Mismatch Telegram Bot (.env)
# ============================================================
# ตั้งค่าเฉพาะสำหรับสคริปต์แจ้งเตือนนัดผิดห้องตรวจเท่านั้น
# แยกอิสระ ไม่เกี่ยวกับไฟล์ .env หลักของเว็บไซต์
# ============================================================

# ── Telegram Bot Configuration ──
# Token ที่ได้จาก @BotFather บน Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# ID ของ Telegram กลุ่ม (มักขึ้นต้นด้วยเครื่องหมายลบ เช่น -100xxxxxxxxxx)
TELEGRAM_CHAT_ID="your_telegram_group_chat_id"

# ── HOSxP Database (Read-Only) ──
# เชื่อมต่อฐานข้อมูล HOSxP ของโรงพยาบาลเถินเพื่ออ่านตาราง oapp และ kskdepartment
APPOINT_DB_HOST="your_appointment_db_host"
APPOINT_DB_PORT="3306"
APPOINT_DB_USER="your_appointment_db_user"
APPOINT_DB_PASSWORD="your_appointment_db_password"
APPOINT_DB_NAME="your_appointment_db_name"
APPOINT_DB_CHARSET="tis620"
