generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model News {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(500)
  slug        String      @unique @db.VarChar(500)
  excerpt     String?     @db.Text
  content     String?     @db.LongText
  youtubeUrl  String?     @map("youtube_url") @db.VarChar(500)
  pdfUrl      String?     @map("pdf_url") @db.VarChar(500)
  status      String      @default("DRAFT") @db.VarChar(50) // DRAFT, PUBLISHED, ARCHIVED
  category    String      @default("PR") @db.VarChar(100) // PR, TRAINING, JOBS, KNOWLEDGE
  views       Int         @default(0)
  publishedAt DateTime    @default(now()) @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  images      NewsImage[]
  viewLogs    NewsView[]

  @@map("news")
}

model NewsImage {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("news_images")
}

model NewsView {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news_id")
  ip        String   @db.VarChar(100)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId, ip])
  @@map("news_views")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  phone     String?  @db.VarChar(50)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}


