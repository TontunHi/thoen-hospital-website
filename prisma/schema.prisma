generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// THOROUGH TABLE OF CONTENTS — Thoen Hospital Website Database (45 Prisma Models)
// เอกสารแผนผังฉบับเต็ม (รวมตารางนอก Prisma เช่น FCT / RCM / HOSxP / Salary):
//   -> docs/database-map.md
//   -> docs/database-map.html (เปิดดูแบบ Interactive ค้นหา/กรองตามระบบได้)
//
// หมวดหมู่ตามระบบบนเว็บ:
//   1. Public CMS & Website Content      (news, attachments, hero_slides, contact_messages)
//   2. Member Auth, RBAC & Audit         (members, member_registrations, *_permissions, *_telegram_*, audit_logs)
//   3. Organization & Departments        (department_groups, department_members, department_roles)
//   4. Official Documents & Quality      (ita_blogs, rdu_*, outgoing_documents, ethics_*)
//   5. Central Inbox & Repair / Media    (inbox_tasks, inbox_task_steps, inbox_task_audit_logs, repair_details)
//   6. Locations, Assets & Borrowing     (hospital_locations, hospital_assets, hospital_materials, equipment_borrow_*)
//   7. Hospital Events & ThaID Check-in  (hospital_events, event_organizers, event_registrations, event_attendances, event_attachments)
//   8. Screening Queue (Smart Card)      (screening_queues)
//   9. KPI & Project/Budget Tracking     (kpi_topics, kpi_indicators, kpi_entries, project_tracking_*)
//  10. Clinical Registries               (palliative_care_registries, palliative_care_registry_visits, dm_remission_*)
// =============================================================================

// =============================================================================
// 1. PUBLIC CMS & WEBSITE CONTENT (ข่าวสาร, สไลด์หน้าแรก, เนื้อหาสาธารณะ)
// =============================================================================

/// ระบบ: ข่าวสารและประกาศประชาสัมพันธ์
/// หน้าเว็บ: /news, /news/[slug], /member/news/news
/// หน้าที่: เก็บหัวข้อข่าว หมวดหมู่ ช่วงวันที่เผยแพร่ และยอดเข้าชม
model News {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(500)
  slug        String       @unique(map: "slug") @db.VarChar(255)
  category    String       @db.VarChar(100)
  youtubeLink String?      @map("youtube_link") @db.VarChar(255)
  startDate   DateTime     @map("start_date") @db.DateTime(0)
  endDate     DateTime     @map("end_date") @db.DateTime(0)
  viewCount   Int?         @default(0) @map("view_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamp(0)
  attachments Attachment[]

  @@index([category], map: "idx_category")
  @@index([startDate, endDate], map: "idx_dates")
  @@map("news")
}

/// ระบบ: ข่าวสารและประกาศประชาสัมพันธ์
/// หน้าเว็บ: /news/[slug], /member/news/news
/// หน้าที่: เก็บไฟล์แนบ/รูปภาพของข่าวแต่ละรายการ (เชื่อมกับ news)
model Attachment {
  id           Int      @id @default(autoincrement())
  newsId       Int      @map("news_id")
  filePath     String   @map("file_path") @db.VarChar(1000)
  fileType     String?  @map("file_type") @db.VarChar(50)
  originalName String?  @map("original_name") @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  news         News     @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attachments_ibfk_1")

  @@index([newsId], map: "news_id")
  @@map("attachments")
}

/// ระบบ: สไลด์ประชาสัมพันธ์หน้าแรก
/// หน้าเว็บ: /, /member/news/slides
/// หน้าที่: เก็บรูปภาพ/วิดีโอ MP4, ลิงก์, ลำดับ และระยะเวลาแสดงผลบน Hero Banner
model HeroSlide {
  id           Int      @id @default(autoincrement())
  imagePath    String   @map("image_path") @db.VarChar(255)
  title        String?  @db.VarChar(255)
  linkUrl      String?  @map("link_url") @db.VarChar(255)
  startDate    DateTime @map("start_date") @db.DateTime(0)
  endDate      DateTime @map("end_date") @db.DateTime(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)
  displayOrder Int      @default(0) @map("display_order")
  duration     Int      @default(6) @map("duration")

  @@map("hero_slides")
}

/// ระบบ: อัลบั้มภาพข่าวและกิจกรรมโรงพยาบาล
/// หน้าเว็บ: /, /gallery, /member/news/gallery
/// หน้าที่: เก็บหัวข้อกิจกรรม วันที่จัดงาน ภาพหน้าปก สถานะการเผยแพร่ และการปักหมุดหน้าแรก
model PhotoAlbum {
  id            Int               @id @default(autoincrement())
  title         String            @db.VarChar(500)
  slug          String            @unique(map: "uq_photo_albums_slug") @db.VarChar(255)
  description   String?           @db.Text
  eventDate     DateTime          @map("event_date") @db.Date
  coverImageUrl String?           @map("cover_image_url") @db.VarChar(1000)
  status        String            @default("PUBLISHED") @db.VarChar(20)
  isPinned      Boolean           @default(false) @map("is_pinned")
  viewCount     Int               @default(0) @map("view_count")
  createdBy     String?           @map("created_by") @db.VarChar(100)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamp(0)
  images        PhotoAlbumImage[]

  @@index([status, isPinned, eventDate, id], map: "idx_album_status_pinned_date")
  @@index([eventDate], map: "idx_album_event_date")
  @@map("photo_albums")
}

/// ระบบ: รูปภาพภายในอัลบั้มภาพข่าวและกิจกรรม
/// หน้าเว็บ: /, /gallery, /member/news/gallery
/// หน้าที่: เก็บรายการรูปภาพ ลำดับการแสดงผล และคำบรรยายภาพ (เชื่อมกับ photo_albums)
model PhotoAlbumImage {
  id           Int        @id @default(autoincrement())
  albumId      Int        @map("album_id")
  imageUrl     String     @map("image_url") @db.VarChar(1000)
  caption      String?    @db.VarChar(500)
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  album        PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "photo_album_images_ibfk_1")

  @@index([albumId, displayOrder, id], map: "idx_album_images_order")
  @@map("photo_album_images")
}

/// [DEPRECATED] ระบบ: ข้อความติดต่อ/ร้องเรียนเดิม (ลบฟีเจอร์ออกจาก UI และ API ถาวรแล้วตาม AGENTS.md)
/// หน้าเว็บ: /contact (เดิม)
/// หน้าที่: ตารางคงค้างจากระบบส่งข้อความติดต่อสอบถามในอดีต
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([createdAt], map: "idx_contact_created")
  @@map("contact_messages")
}

// =============================================================================
// 2. MEMBER ACCOUNTS, AUTH, RBAC, TELEGRAM & AUDIT (สมาชิก, สิทธิ์, ความปลอดภัย)
// =============================================================================

/// ระบบ: บัญชีบุคลากรและผู้ใช้งานระบบ (/member)
/// หน้าเว็บ: /member, /member/login, /member/member, /member/signature
/// หน้าที่: ตารางหลักของสมาชิก (เลขบัตรประชาชน/username, ข้อมูลพื้นฐาน, OTP, รูปโปรไฟล์, ลายเซ็น)
model Member {
  id                       Int                        @id @default(autoincrement())
  username                 String                     @unique(map: "username") @db.VarChar(100)
  email                    String                     @unique(map: "email") @db.VarChar(100)
  name                     String?                    @db.VarChar(255)
  department               String?                    @db.VarChar(100)
  salaryUser               String?                    @map("salary_user") @db.VarChar(100)
  salaryPass               String?                    @map("salary_pass") @db.VarChar(100)
  role                     String                     @default("member") @db.VarChar(50)
  otpCode                  String?                    @map("otp_code") @db.VarChar(10)
  otpExpiry                DateTime?                  @map("otp_expiry") @db.DateTime(0)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  profilePath              String?                    @map("profile_path") @db.VarChar(255)
  position                 String?                    @db.VarChar(100)
  signaturePath            String?                    @map("signature_path") @db.VarChar(255)
  ita_blogs                ita_blogs[]
  member_telegram_links    member_telegram_links?
  telegram_link_challenges telegram_link_challenges[]
  hospital_assets          HospitalAsset[]
  member_permissions       MemberPermission[]
  eventsHeadOrganized      HospitalEvent[]            @relation("EventHeadOrganizer")
  eventOrganizers          EventOrganizer[]
  eventRegistrations       EventRegistration[]
  eventAttendances         EventAttendance[]
  eventAttachments         EventAttachment[]
  onlineMediaViews         OnlineMediaView[]

  @@map("members")
}

/// ระบบ: ลงทะเบียนบุคลากรใหม่
/// หน้าเว็บ: /register, /member/registrations
/// หน้าที่: คำขอสมัครสมาชิกที่บุคลากรส่งผ่าน /register เพื่อรอ Admin อนุมัติ (แยกจาก members ที่ล็อกอินได้แล้ว)
model MemberRegistration {
  id                  Int       @id @default(autoincrement())
  citizenId           String    @map("citizen_id") @db.VarChar(13)
  title               String    @db.VarChar(50)
  firstNameTh         String    @map("first_name_th") @db.VarChar(100)
  lastNameTh          String    @map("last_name_th") @db.VarChar(100)
  firstNameEn         String    @map("first_name_en") @db.VarChar(100)
  lastNameEn          String    @map("last_name_en") @db.VarChar(100)
  nickname            String    @db.VarChar(50)
  licenseNo           String?   @map("license_no") @db.VarChar(100)
  birthDate           String    @map("birth_date") @db.VarChar(50)
  startDate           String    @map("start_date") @db.VarChar(50)
  containDate         String?   @map("contain_date") @db.VarChar(50)
  department          String    @db.VarChar(150)
  position            String    @db.VarChar(150)
  level               String    @db.VarChar(100)
  personnelGroup      String    @map("personnel_group") @db.VarChar(100)
  personnelGroupOther String?   @map("personnel_group_other") @db.VarChar(150)
  hasHosxp            Boolean   @default(false) @map("has_hosxp")
  hosxpUser           String?   @map("hosxp_user") @db.VarChar(100)
  hosxpPass           String?   @map("hosxp_pass") @db.VarChar(255)
  email               String    @db.VarChar(100)
  phone               String    @db.VarChar(50)
  lineId              String?   @map("line_id") @db.VarChar(100)
  inHospitalHousing   Boolean   @default(false) @map("in_hospital_housing")
  housingLocation     String?   @map("housing_location") @db.VarChar(100)
  hasVehicle          Boolean   @default(false) @map("has_vehicle")
  vehicles            Json?
  status              String    @default("pending") @db.VarChar(20)
  rejectReason        String?   @map("reject_reason") @db.Text
  approvedAt          DateTime? @map("approved_at") @db.Timestamp(0)
  approvedBy          String?   @map("approved_by") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([citizenId], map: "idx_registration_citizen")
  @@index([status], map: "idx_registration_status")
  @@index([email], map: "idx_registration_email")
  @@map("member_registrations")
}

/// ระบบ: ตั้งค่าระบบสมาชิก (Key-Value Config)
/// หน้าเว็บ: /member/settings
/// หน้าที่: เก็บค่าตั้งค่าทั่วไปของระบบสมาชิก (เช่น ค่าเริ่มต้นหรือ flag การทำงาน)
model MemberSystemSetting {
  configKey   String @id @map("config_key") @db.VarChar(100)
  configValue String @map("config_value") @db.VarChar(255)

  @@map("member_system_settings")
}

/// ระบบ: กำหนดสิทธิ์ตามตำแหน่ง (Position-based RBAC)
/// หน้าเว็บ: /member/settings
/// หน้าที่: ผูก permission_key เข้ากับชื่อตำแหน่ง (ทุกคนที่ครองตำแหน่งนั้นจะได้สิทธิ์อัตโนมัติ)
model PositionPermission {
  id            Int      @id @default(autoincrement())
  permissionKey String   @map("permission_key") @db.VarChar(100)
  positionName  String   @map("position_name") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@unique([permissionKey, positionName], map: "uq_permission_position")
  @@map("position_permissions")
}

/// ระบบ: กำหนดสิทธิ์รายบุคคล (Member-based RBAC)
/// หน้าเว็บ: /member/settings
/// หน้าที่: มอบ permission_key เจาะจงให้สมาชิกรายคน (View / Edit / Approve / Manage)
model MemberPermission {
  id            Int      @id @default(autoincrement())
  memberId      Int      @map("member_id")
  permissionKey String   @map("permission_key") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  createdBy     String?  @map("created_by") @db.VarChar(100)

  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionKey], map: "uq_member_permission")
  @@index([memberId], map: "idx_member_perm_id")
  @@index([permissionKey], map: "idx_member_perm_key")
  @@map("member_permissions")
}

/// ระบบ: แจ้งเตือน Telegram บุคลากร
/// หน้าเว็บ: /member (เมนูเชื่อมต่อ Telegram)
/// หน้าที่: เก็บการจับคู่ระหว่างบัญชี Member กับ telegram_chat_id เพื่อรับแจ้งเตือนงานซ่อม/อนุมัติ
model member_telegram_links {
  id                BigInt   @id @default(autoincrement())
  member_id         Int      @unique(map: "member_id")
  telegram_chat_id  BigInt   @unique(map: "telegram_chat_id")
  telegram_user_id  BigInt   @unique(map: "telegram_user_id")
  telegram_username String?  @db.VarChar(100)
  first_name        String?  @db.VarChar(150)
  linked_at         DateTime @default(now()) @db.DateTime(0)
  updated_at        DateTime @default(now()) @db.DateTime(0)
  members           Member   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "member_telegram_links_ibfk_1")

  @@index([telegram_chat_id], map: "idx_chat_id")
  @@index([member_id], map: "idx_member_id")
}

/// ระบบ: แจ้งเตือน Telegram บุคลากร
/// หน้าเว็บ: /member (ขั้นตอนยืนยันเชื่อมบัญชี Telegram)
/// หน้าที่: เก็บ One-time Token (Hash) ชั่วคราวสำหรับยืนยันการผูก Telegram Bot
model telegram_link_challenges {
  id         BigInt    @id @default(autoincrement())
  member_id  Int
  token_hash String    @unique(map: "token_hash") @db.VarChar(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  members    Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "telegram_link_challenges_ibfk_1")

  @@index([token_hash, expires_at], map: "idx_token_lookup")
  @@index([member_id], map: "member_id")
}

/// ระบบ: ตรวจสอบความปลอดภัยและ PDPA (Tier 1 Audit Log)
/// หน้าเว็บ: /member/audit-logs (และทุก Route ที่เรียก logAudit())
/// หน้าที่: บันทึกประวัติการเข้าถึง/แก้ไขข้อมูลผู้ป่วย (PHI), สลิปเงินเดือน, การล็อกอิน และการตั้งค่าแอดมิน
model AuditLog {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now()) @db.Timestamp(0)
  username      String?  @db.VarChar(100)
  email         String?  @db.VarChar(100)
  actionType    String   @map("action_type") @db.VarChar(50)
  targetTable   String?  @map("target_table") @db.VarChar(100)
  actionDetails String?  @map("action_details") @db.Text
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)

  @@index([username], map: "idx_username")
  @@index([actionType], map: "idx_action_type")
  @@index([timestamp], map: "idx_timestamp")
  @@map("audit_logs")
}

// =============================================================================
// 3. ORGANIZATION & DEPARTMENTS (โครงสร้างองค์กรและกลุ่มงาน)
// =============================================================================

/// ระบบ: โครงสร้างองค์กรและกลุ่มงาน
/// หน้าเว็บ: /about/organization, /member/organization
/// หน้าที่: เก็บโครงสร้างกลุ่มงาน/ฝ่ายแบบลำดับชั้น (Self-referencing parent_id)
model DepartmentGroup {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(200)
  parentId    Int?                @map("parent_id")
  orderIndex  Int                 @default(0) @map("order_index")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  parent      DepartmentGroup?    @relation("DepartmentGroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    DepartmentGroup[]   @relation("DepartmentGroupHierarchy")
  members     DepartmentMember[]

  @@index([parentId], map: "idx_dept_group_parent")
  @@index([orderIndex], map: "idx_dept_group_order")
  @@map("department_groups")
}

/// ระบบ: โครงสร้างองค์กรและกลุ่มงาน
/// หน้าเว็บ: /about/organization, /member/organization
/// หน้าที่: เก็บรายชื่อบุคลากร ตำแหน่ง รูปภาพ และบทบาทภายในแต่ละกลุ่มงาน
model DepartmentMember {
  id          Int              @id @default(autoincrement())
  groupId     Int              @map("group_id")
  name        String           @db.VarChar(255)
  position    String           @db.VarChar(200)
  role        String           @default("member") @db.VarChar(50)
  orderIndex  Int              @default(0) @map("order_index")
  imagePath   String?          @map("image_path") @db.VarChar(255)
  phone       String?          @db.VarChar(50)
  memberId    Int?             @map("member_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  group       DepartmentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId], map: "idx_dept_member_group")
  @@index([orderIndex], map: "idx_dept_member_order")
  @@index([role], map: "idx_dept_member_role")
  @@map("department_members")
}

/// ระบบ: โครงสร้างองค์กรและกลุ่มงาน
/// หน้าเว็บ: /member/organization
/// หน้าที่: เก็บตัวเลือกบทบาทมาตรฐานในกลุ่มงาน (เช่น หัวหน้ากลุ่มงาน, รองหัวหน้า, ผู้ปฏิบัติงาน)
model DepartmentRole {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  orderIndex Int      @default(0) @map("order_index")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([orderIndex], map: "idx_dept_role_order")
  @@map("department_roles")
}

// =============================================================================
// 4. OFFICIAL DOCUMENTS & QUALITY (ITA, RDU, หนังสือส่งออก, ชมรมจริยธรรม)
// =============================================================================

/// ระบบ: ข้อมูลคุณธรรมและความโปร่งใส (ITA)
/// หน้าเว็บ: /ita, /ita/[slug], /member/ita
/// หน้าที่: เก็บบทความ/รายงานข้อมูล ITA พร้อมเนื้อหา HTML/LongText และข้อมูลผู้เขียน
model ita_blogs {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(500)
  slug            String?  @db.VarChar(500)
  content         String   @db.LongText
  author_id       Int
  author_name     String?  @db.VarChar(255)
  author_position String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
  members         Member   @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ita_blogs_ibfk_1")

  @@index([author_id], map: "author_id")
}

/// ระบบ: คลังเอกสารการใช้ยาอย่างสมเหตุผล (RDU)
/// หน้าเว็บ: /rdu, /member/rdu
/// หน้าที่: เก็บโฟลเดอร์หมวดหมู่เอกสาร RDU และลำดับการแสดงผล
model rdu_folders {
  id            Int         @id @default(autoincrement())
  folder_name   String      @unique(map: "folder_name") @db.VarChar(255)
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  rdu_files     rdu_files[]
}

/// ระบบ: คลังเอกสารการใช้ยาอย่างสมเหตุผล (RDU)
/// หน้าเว็บ: /rdu, /member/rdu
/// หน้าที่: เก็บไฟล์ PDF/เอกสารภายในแต่ละโฟลเดอร์ RDU
model rdu_files {
  id            Int         @id @default(autoincrement())
  folder_id     Int
  display_name  String      @db.VarChar(255)
  file_name     String      @db.VarChar(255)
  file_path     String      @db.VarChar(500)
  file_size     BigInt?
  display_order Int         @default(0)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  rdu_folders   rdu_folders @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "rdu_files_ibfk_1")

  @@index([folder_id], map: "folder_id")
}

/// ระบบ: ทะเบียนหนังสือส่งออก
/// หน้าเว็บ: /service/outgoing-document, /member/outgoing-document
/// หน้าที่: เก็บลิงก์ Google Sheets ทะเบียนหนังสือส่งออกแยกตามปีงบประมาณ พ.ศ. และสถานะการใช้งาน
model OutgoingDocument {
  id           Int      @id @default(autoincrement())
  year         String   @db.VarChar(10)
  label        String   @db.VarChar(255)
  note         String?  @db.VarChar(500)
  url          String   @db.VarChar(1000)
  status       String   @default("เสร็จสิ้น") @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.VarChar(100)
  updatedBy    String?  @map("updated_by") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([year], map: "idx_outgoing_doc_year")
  @@index([isActive], map: "idx_outgoing_doc_active")
  @@map("outgoing_documents")
}

/// ระบบ: งานชมรมจริยธรรม
/// หน้าเว็บ: /ethics, /member/ethics
/// หน้าที่: เก็บปีงบประมาณหลักสำหรับจัดกลุ่มเอกสารชมรมจริยธรรม
model EthicsYear {
  id           Int              @id @default(autoincrement())
  year         String           @unique(map: "uq_ethics_year") @db.VarChar(10)
  displayOrder Int              @default(0) @map("display_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  documents    EthicsDocument[]

  @@index([displayOrder], map: "idx_ethics_year_order")
  @@map("ethics_years")
}

/// ระบบ: งานชมรมจริยธรรม
/// หน้าเว็บ: /ethics, /member/ethics
/// หน้าที่: เก็บโครงสร้างเอกสารแบบ Tree (โฟลเดอร์ย่อย/ไฟล์) ภายใต้ปีของชมรมจริยธรรม
model EthicsDocument {
  id           Int              @id @default(autoincrement())
  yearId       Int              @map("year_id")
  parentId     Int?             @map("parent_id")
  title        String           @db.VarChar(500)
  filePath     String?          @map("file_path") @db.VarChar(1000)
  fileSize     BigInt?          @map("file_size")
  displayOrder Int              @default(0) @map("display_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  year         EthicsYear       @relation(fields: [yearId], references: [id], onDelete: Cascade)
  parent       EthicsDocument?  @relation("EthicsSubDocuments", fields: [parentId], references: [id], onDelete: Cascade)
  children     EthicsDocument[] @relation("EthicsSubDocuments")

  @@index([yearId], map: "idx_ethics_doc_year")
  @@index([parentId], map: "idx_ethics_doc_parent")
  @@map("ethics_documents")
}

// =============================================================================
// 5. CENTRAL INBOX & REPAIR / MEDIA WORKFLOW (กล่องงานกลาง, แจ้งซ่อม, ขอสื่อ)
// =============================================================================

/// ระบบ: กล่องงานกลาง (ขอผลิตสื่อ + แจ้งซ่อม IT/ทั่วไป/เครื่องมือแพทย์)
/// หน้าเว็บ: /member/inbox, /member/inbox/[id], /member/media-requests, /member/repairs/new
/// หน้าที่: เก็บใบคำร้องงานหลัก เลขที่งาน สถานะปัจจุบัน ผู้ขอ และข้อมูล JSON เฉพาะสายงาน
model Task {
  id              String         @id @default(uuid()) @db.VarChar(36)
  taskNo          String         @unique(map: "uq_task_no") @map("task_no") @db.VarChar(50)
  taskType        String         @map("task_type") @db.VarChar(50)
  title           String         @db.VarChar(500)
  description     String?        @db.Text
  urgency         String         @default("NORMAL") @db.VarChar(20)
  
  requesterId     Int            @map("requester_id")
  requesterName   String         @map("requester_name") @db.VarChar(255)
  requesterDept   String?        @map("requester_dept") @db.VarChar(100)
  
  status          String         @default("PENDING") @db.VarChar(30)
  currentStepNo   Int            @default(1) @map("current_step_no")
  currentAssignee Int?           @map("current_assignee")
  currentRole     String?        @map("current_role") @db.VarChar(100)

  referenceId     String?        @map("reference_id") @db.VarChar(100)
  customPayload   String?        @map("custom_payload") @db.LongText

  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  steps           TaskStep[]
  auditLogs       TaskAuditLog[]
  repairDetail    RepairDetail?

  @@index([currentAssignee, status], map: "idx_task_assignee_status")
  @@index([taskType, status], map: "idx_task_type_status")
  @@index([requesterId], map: "idx_task_requester")
  @@map("inbox_tasks")
}

/// ระบบ: กล่องงานกลาง (Workflow ขั้นตอนอนุมัติและดำเนินการ)
/// หน้าเว็บ: /member/inbox/[id], /member/inbox/[id]/print, /member/media-requests/[id]/print
/// หน้าที่: เก็บแต่ละขั้นตอน (Step 1..N) ผู้รับผิดชอบ ผลการอนุมัติ และลายมือชื่ออิเล็กทรอนิกส์ (Hash)
model TaskStep {
  id             String         @id @default(uuid()) @db.VarChar(36)
  taskId         String         @map("task_id") @db.VarChar(36)
  stepNo         Int            @map("step_no")
  stepName       String         @map("step_name") @db.VarChar(255)
  
  assigneeType   String         @default("INDIVIDUAL") @map("assignee_type") @db.VarChar(30)
  assignedToId   Int?           @map("assigned_to_id")
  assignedRole   String?        @map("assigned_role") @db.VarChar(100)
  
  status         String         @default("WAITING") @db.VarChar(30)
  
  actionTaken    String?        @map("action_taken") @db.VarChar(50)
  actionBy       Int?           @map("action_by")
  actionByName   String?        @map("action_by_name") @db.VarChar(255)
  actionAt       DateTime?      @map("action_at") @db.DateTime(0)
  comment        String?        @db.Text
  
  signaturePath  String?        @map("signature_path") @db.VarChar(255)
  signatureHash  String?        @map("signature_hash") @db.VarChar(64)

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepNo], map: "uq_task_step_no")
  @@index([assignedToId, status], map: "idx_step_assignee_status")
  @@map("inbox_task_steps")
}

/// ระบบ: กล่องงานกลาง (Tier 2 Workflow Audit Log)
/// หน้าเว็บ: /member/inbox/[id]
/// หน้าที่: เก็บประวัติการเปลี่ยนสถานะและ Diff การแก้ไขโดยผู้จัดการระบบ (MANAGER_EDIT_TASK)
model TaskAuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  taskId      String   @map("task_id") @db.VarChar(36)
  action      String   @db.VarChar(50)
  performedBy Int      @map("performed_by")
  performerName String? @map("performer_name") @db.VarChar(255)
  details     String?  @db.LongText
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "idx_audit_task_id")
  @@map("inbox_task_audit_logs")
}

/// ระบบ: แจ้งซ่อม 3 สายงาน (IT / ทั่วไป / เครื่องมือแพทย์)
/// หน้าเว็บ: /member/repairs/new, /member/inbox/[id]
/// หน้าที่: เก็บรายละเอียดงานซ่อม (เลขครุภัณฑ์ สถานที่ อาการ ช่างผู้รับผิดชอบ ส่งซ่อมภายนอก ค่าใช้จ่าย รูปถ่าย)
model RepairDetail {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  taskId                String   @unique(map: "uq_repair_task_id") @map("task_id") @db.VarChar(36)
  repairType            String   @map("repair_type") @db.VarChar(50)
  itemCategory          String   @default("EQUIPMENT") @map("item_category") @db.VarChar(30)
  equipmentNumber       String?  @map("equipment_number") @db.VarChar(100)
  equipmentName         String?  @map("equipment_name") @db.VarChar(255)
  nonEquipmentItem      String?  @map("non_equipment_item") @db.VarChar(255)
  locationId            Int?     @map("location_id")
  locationFullName      String   @map("location_full_name") @db.VarChar(500)
  symptomDetail         String   @map("symptom_detail") @db.Text
  assignedTechnicianId  Int?     @map("assigned_technician_id")
  assignedTechnicianName String? @map("assigned_technician_name") @db.VarChar(255)
  coWorkers             Json?    @map("co_workers")
  repairNature          String   @default("NORMAL") @map("repair_nature") @db.VarChar(50)
  repairStatus          String   @default("WAITING") @map("repair_status") @db.VarChar(50)
  isExternalRepair      Boolean  @default(false) @map("is_external_repair")
  externalVendorName    String?  @map("external_vendor_name") @db.VarChar(255)
  externalReason        String?  @map("external_reason") @db.Text
  costType              String   @default("NO_COST") @map("cost_type") @db.VarChar(30)
  costAmount            Decimal? @map("cost_amount") @db.Decimal(10, 2)
  foundProblem          String?  @map("found_problem") @db.Text
  solutionStep          String?  @map("solution_step") @db.Text
  photos                Json?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  task                  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([repairType], map: "idx_repair_type")
  @@index([repairStatus], map: "idx_repair_status")
  @@map("repair_details")
}

// =============================================================================
// 6. LOCATIONS, ASSETS & EQUIPMENT BORROWING (สถานที่, ครุภัณฑ์, ระบบยืม-คืน)
// =============================================================================

/// ระบบ: จัดการสถานที่/ห้องในโรงพยาบาล (อ้างอิง LEVEL_ROOM_ID จาก Gotowin)
/// หน้าเว็บ: /member/locations (และใช้เลือกห้องในแจ้งซ่อม/ทะเบียนครุภัณฑ์)
/// หน้าที่: เก็บข้อมูลอาคาร ชั้น ห้อง และชื่อเต็มสำหรับผูกกับครุภัณฑ์และงานแจ้งซ่อม
model HospitalLocation {
  id           Int      @id @map("id") // LEVEL_ROOM_ID from Gotowin
  roomName     String   @map("room_name") @db.VarChar(200)
  floorId      Int      @map("floor_id")
  floorName    String   @map("floor_name") @db.VarChar(50)
  buildingId   Int      @map("building_id")
  buildingName String   @map("building_name") @db.VarChar(200)
  fullName     String   @map("full_name") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  hospital_assets HospitalAsset[]

  @@index([buildingId, floorId], map: "idx_loc_building_floor")
  @@index([roomName], map: "idx_loc_room_name")
  @@map("hospital_locations")
}

/// ระบบ: ทะเบียนครุภัณฑ์โรงพยาบาล (ซิงก์จาก Gotowin)
/// หน้าเว็บ: /member/assets, /member/equipment-borrow
/// หน้าที่: เก็บเลขครุภัณฑ์ รหัส FSN หมวดหมู่ (IT/Medical/General) ประกัน ผู้ดูแล และแฟล็ก is_loanable
model HospitalAsset {
  id                Int               @id @default(autoincrement())
  articleNum        String            @unique(map: "uq_asset_article_num") @map("article_num") @db.VarChar(100)
  fsnNum            String?           @map("fsn_num") @db.VarChar(50)
  name              String            @map("name") @db.VarChar(255)
  brand             String?           @map("brand") @db.VarChar(100)
  model             String?           @map("model") @db.VarChar(100)
  serialNo          String?           @map("serial_no") @db.VarChar(100)
  category          String            @default("GENERAL") @map("category") @db.VarChar(30)
  
  locationId        Int?              @map("location_id")
  locationFullName  String?           @map("location_full_name") @db.VarChar(500)
  department        String?           @map("department") @db.VarChar(100)
  custodianId       Int?              @map("custodian_id")
  
  receivedDate      DateTime?         @map("received_date") @db.Date
  warrantyStartDate DateTime?         @map("warranty_start_date") @db.Date
  warrantyEndDate   DateTime?         @map("warranty_end_date") @db.Date
  expireDate        DateTime?         @map("expire_date") @db.Date
  
  price             Decimal?          @map("price") @db.Decimal(12, 2)
  vendorName        String?           @map("vendor_name") @db.VarChar(255)
  vendorContact     String?           @map("vendor_contact") @db.VarChar(255)
  contractNo        String?           @map("contract_no") @db.VarChar(100)
  
  status            String            @default("ACTIVE") @map("status") @db.VarChar(30)
  isLoanable        Boolean           @default(false) @map("is_loanable")
  imageUrl          String?           @map("image_url") @db.VarChar(500)
  notes             String?           @map("notes") @db.Text
  
  gtwArticleId      Int?              @map("gtw_article_id")
  
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  custodian         Member?           @relation(fields: [custodianId], references: [id], onDelete: SetNull)
  location          HospitalLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  borrowItems       EquipmentBorrowItem[]

  @@index([category], map: "idx_asset_category")
  @@index([status], map: "idx_asset_status")
  @@index([isLoanable], map: "idx_asset_is_loanable")
  @@index([department], map: "idx_asset_department")
  @@index([locationId], map: "idx_asset_location")
  @@index([warrantyEndDate], map: "idx_asset_warranty")
  @@map("hospital_assets")
}

/// ระบบ: ยืม-คืนอุปกรณ์และเบิกวัสดุ
/// หน้าเว็บ: /member/equipment-borrow
/// หน้าที่: เก็บคลังวัสดุ (ทั้งแบบหมุนเวียน REUSABLE และสิ้นเปลือง CONSUMABLE) พร้อมสต็อกคงเหลือ
model HospitalMaterial {
  id           Int                   @id @default(autoincrement())
  name         String                @db.VarChar(255)
  category     String                @default("GENERAL") @db.VarChar(50)
  materialType String                @default("REUSABLE") @map("material_type") @db.VarChar(30)
  totalQty     Int                   @default(0) @map("total_qty")
  availableQty Int                   @default(0) @map("available_qty")
  unit         String                @default("ชิ้น") @db.VarChar(50)
  location     String?               @db.VarChar(255)
  imageUrl     String?               @map("image_url") @db.VarChar(500)
  notes        String?               @db.Text
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  borrowItems  EquipmentBorrowItem[]

  @@index([category], map: "idx_material_category")
  @@index([materialType], map: "idx_material_type")
  @@index([isActive], map: "idx_material_is_active")
  @@map("hospital_materials")
}

/// ระบบ: ยืม-คืนอุปกรณ์และเบิกวัสดุ
/// หน้าเว็บ: /member/equipment-borrow
/// หน้าที่: เก็บใบคำขอยืม-เบิกวัสดุ (หัวเอกสาร) วันที่ยืม-คืน กำหนดส่ง และสถานะการอนุมัติ
model EquipmentBorrowRequest {
  id                 Int                   @id @default(autoincrement())
  requestNo          String                @unique(map: "uq_borrow_request_no") @map("request_no") @db.VarChar(50)
  requesterId        Int                   @map("requester_id")
  requesterName      String                @map("requester_name") @db.VarChar(255)
  requesterDept      String?               @map("requester_dept") @db.VarChar(150)
  purpose            String                @db.Text
  location           String?               @db.VarChar(255)
  borrowDate         DateTime              @map("borrow_date") @db.Date
  expectedReturnDate DateTime?             @map("expected_return_date") @db.Date
  actualReturnDate   DateTime?             @map("actual_return_date") @db.DateTime(0)
  phone              String?               @db.VarChar(50)
  notes              String?               @db.Text
  status             String                @default("PENDING") @db.VarChar(30)
  approvedById       Int?                  @map("approved_by_id")
  approvedByName     String?               @map("approved_by_name") @db.VarChar(255)
  approvedAt         DateTime?             @map("approved_at") @db.DateTime(0)
  rejectReason       String?               @map("reject_reason") @db.Text
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  items              EquipmentBorrowItem[]
  events             HospitalEvent[]

  @@index([requesterId], map: "idx_borrow_requester")
  @@index([status], map: "idx_borrow_status")
  @@index([borrowDate], map: "idx_borrow_date")
  @@index([expectedReturnDate], map: "idx_borrow_expected_return")
  @@map("equipment_borrow_requests")
}

/// ระบบ: ยืม-คืนอุปกรณ์และเบิกวัสดุ
/// หน้าเว็บ: /member/equipment-borrow
/// หน้าที่: เก็บรายการอุปกรณ์/วัสดุย่อยในใบขอยืม (Multi-item) พร้อมผลการตรวจรับคืน
model EquipmentBorrowItem {
  id              Int                    @id @default(autoincrement())
  requestId       Int                    @map("request_id")
  itemType        String                 @map("item_type") @db.VarChar(20)
  assetId         Int?                   @map("asset_id")
  materialId      Int?                   @map("material_id")
  itemName        String                 @map("item_name") @db.VarChar(255)
  itemCode        String?                @map("item_code") @db.VarChar(100)
  quantity        Int                    @default(1)
  returnedQty     Int                    @default(0) @map("returned_qty")
  status          String                 @default("BORROWED") @db.VarChar(30)
  returnCondition String?                @map("return_condition") @db.VarChar(30)
  returnNotes     String?                @map("return_notes") @db.Text
  returnedAt      DateTime?              @map("returned_at") @db.DateTime(0)
  inspectedById   Int?                   @map("inspected_by_id")
  inspectedByName String?                @map("inspected_by_name") @db.VarChar(255)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  request         EquipmentBorrowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset           HospitalAsset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  material        HospitalMaterial?      @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([requestId], map: "idx_item_request_id")
  @@index([assetId], map: "idx_item_asset_id")
  @@index([materialId], map: "idx_item_material_id")
  @@index([status], map: "idx_item_status")
  @@map("equipment_borrow_items")
}

// =============================================================================
// 7. HOSPITAL EVENTS & THAID QR CHECK-IN (ระบบกิจกรรม, ลงทะเบียน, เช็คอิน, คะแนน)
// =============================================================================

/// ระบบ: กิจกรรมโรงพยาบาลและเช็คอินด้วย ThaID
/// หน้าเว็บ: /member/events, /member/events/create, /member/events/[id]
/// หน้าที่: เก็บข้อมูลกิจกรรม ช่วงเวลาจัดงาน/สแกน QR Token, ผู้รับผิดชอบหลัก และใบยืมอุปกรณ์ที่ผูกไว้
model HospitalEvent {
  id               Int                   @id @default(autoincrement())
  title            String                @db.VarChar(500)
  description      String?               @db.Text
  location         String?               @db.VarChar(255)
  bannerUrl        String?               @map("banner_url") @db.VarChar(500)
  
  eventStartDate   DateTime              @map("event_start_date") @db.DateTime(0)
  eventEndDate     DateTime              @map("event_end_date") @db.DateTime(0)
  checkinOpenTime  DateTime              @map("checkin_open_time") @db.DateTime(0)
  checkinCloseTime DateTime              @map("checkin_close_time") @db.DateTime(0)
  
  headOrganizerId  Int                   @map("head_organizer_id")
  borrowRequestId  Int?                  @map("borrow_request_id")
  qrToken          String                @unique(map: "uq_event_qr_token") @map("qr_token") @db.VarChar(64)
  fiscalYear       String                @default("2570") @map("fiscal_year") @db.VarChar(10)
  status           String                @default("UPCOMING") @db.VarChar(30)
  
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  headOrganizer    Member                @relation("EventHeadOrganizer", fields: [headOrganizerId], references: [id])
  borrowRequest    EquipmentBorrowRequest? @relation(fields: [borrowRequestId], references: [id], onDelete: SetNull)
  coOrganizers     EventOrganizer[]
  registrations    EventRegistration[]
  attendances      EventAttendance[]
  attachments      EventAttachment[]

  @@index([fiscalYear, status], map: "idx_event_year_status")
  @@index([eventStartDate], map: "idx_event_start_date")
  @@index([headOrganizerId], map: "idx_event_head_organizer")
  @@map("hospital_events")
}

/// ระบบ: กิจกรรมโรงพยาบาลและเช็คอินด้วย ThaID
/// หน้าเว็บ: /member/events/[id]
/// หน้าที่: เก็บผู้รับผิดชอบร่วม (Co-organizers) ของแต่ละกิจกรรม
model EventOrganizer {
  id        Int           @id @default(autoincrement())
  eventId   Int           @map("event_id")
  memberId  Int           @map("member_id")
  roleTitle String?       @default("ผู้รับผิดชอบร่วม") @map("role_title") @db.VarChar(100)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(0)

  event     HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_organizer")
  @@index([memberId], map: "idx_event_org_member")
  @@map("event_organizers")
}

/// ระบบ: กิจกรรมโรงพยาบาลและเช็คอินด้วย ThaID
/// หน้าเว็บ: /member/events/[id]
/// หน้าที่: เก็บรายชื่อบุคลากรที่กดลงทะเบียนเข้าร่วมกิจกรรมล่วงหน้า
model EventRegistration {
  id           Int           @id @default(autoincrement())
  eventId      Int           @map("event_id")
  memberId     Int           @map("member_id")
  registeredAt DateTime      @default(now()) @map("registered_at") @db.Timestamp(0)

  event        HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_registration")
  @@index([memberId], map: "idx_event_reg_member")
  @@map("event_registrations")
}

/// ระบบ: กิจกรรมโรงพยาบาลและเช็คอินด้วย ThaID
/// หน้าเว็บ: /member/events/checkin-status, /member/events/leaderboard
/// หน้าที่: เก็บประวัติการเช็คอินสำเร็จผ่าน ThaID QR (1 คน/1 งาน) และคะแนนเข้าร่วมกิจกรรม
model EventAttendance {
  id            Int           @id @default(autoincrement())
  eventId       Int           @map("event_id")
  memberId      Int           @map("member_id")
  citizenId     String        @map("citizen_id") @db.VarChar(13)
  checkedInAt   DateTime      @default(now()) @map("checked_in_at") @db.Timestamp(0)
  pointsAwarded Int           @default(1) @map("points_awarded")

  event         HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_attendance")
  @@index([checkedInAt], map: "idx_attendance_time")
  @@index([memberId], map: "idx_attendance_member")
  @@map("event_attendances")
}

/// ระบบ: กิจกรรมโรงพยาบาลและเช็คอินด้วย ThaID
/// หน้าเว็บ: /member/events/[id]
/// หน้าที่: เก็บเอกสารแนบ รูปภาพ และบันทึกข้อความประกอบกิจกรรม
model EventAttachment {
  id                 Int           @id @default(autoincrement())
  eventId            Int           @map("event_id")
  attachmentType     String        @map("attachment_type") @db.VarChar(20)
  title              String        @db.VarChar(255)
  filePath           String?       @map("file_path") @db.VarChar(1000)
  fileType           String?       @map("file_type") @db.VarChar(100)
  fileSize           BigInt?       @map("file_size")
  textContent        String?       @map("text_content") @db.Text
  uploadedByMemberId Int?          @map("uploaded_by_member_id")
  displayOrder       Int           @default(0) @map("display_order")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  event              HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy         Member?       @relation(fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  @@index([eventId], map: "idx_event_attachment_event")
  @@index([attachmentType], map: "idx_event_attachment_type")
  @@index([uploadedByMemberId], map: "idx_event_attachment_uploader")
  @@map("event_attachments")
}

// =============================================================================
// 8. PROACTIVE SCREENING QUEUE (ระบบคิวคัดกรองบัตรประชาชน Smart Card)
// =============================================================================

/// ระบบ: คิวคัดกรองสุขภาพ Smart Card Reader
/// หน้าเว็บ: /service/screening, /service/screening/scan
/// หน้าที่: เก็บข้อมูลผู้รับบริการที่อ่านจากบัตรประชาชน (WAITING / VISIT_OPENED / CANCELLED)
model ScreeningQueue {
  id          Int      @id @default(autoincrement())
  cid         String   @db.VarChar(13)
  title       String?  @db.VarChar(50)
  firstName   String?  @map("first_name") @db.VarChar(100)
  lastName    String?  @map("last_name") @db.VarChar(100)
  fullName    String   @map("full_name") @db.VarChar(255)
  gender      String?  @db.VarChar(10)
  birthDate   String?  @map("birth_date") @db.VarChar(20)
  address     String?  @db.Text
  photoBase64 String?  @map("photo_base64") @db.LongText
  rawPayload  String?  @map("raw_payload") @db.LongText
  status      String   @default("WAITING") @db.VarChar(30)
  vn          String?  @db.VarChar(50)
  recordedBy  Int?     @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([createdAt], map: "idx_screening_created")
  @@index([cid], map: "idx_screening_cid")
  @@index([status], map: "idx_screening_status")
  @@map("screening_queues")
}

// =============================================================================
// 9. KPI & PROJECT / BUDGET TRACKING (ตัวชี้วัด KPI และติดตามโครงการ/งบประมาณ)
// =============================================================================

/// ระบบ: ติดตามตัวชี้วัด KPI โรงพยาบาล
/// หน้าเว็บ: /service/kpi-tracker
/// หน้าที่: เก็บหมวดหมู่/หัวข้อหลักของตัวชี้วัด KPI แยกตามปีงบประมาณ
model KpiTopic {
  id          Int            @id @default(autoincrement())
  fiscalYear  String         @map("fiscal_year") @db.VarChar(10)
  code        String         @db.VarChar(100)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  indicators  KpiIndicator[]

  @@unique([fiscalYear, code], map: "uq_kpi_topic_year_code")
  @@index([fiscalYear], map: "idx_kpi_topic_year")
  @@map("kpi_topics")
}

/// ระบบ: ติดตามตัวชี้วัด KPI โรงพยาบาล
/// หน้าเว็บ: /service/kpi-tracker
/// หน้าที่: เก็บนิยามตัวชี้วัดย่อย เป้าหมาย (Target) ความถี่การเก็บ และผู้รับผิดชอบ
model KpiIndicator {
  id              Int        @id @default(autoincrement())
  topicId         Int        @map("topic_id")
  sequence        String?    @db.VarChar(50)
  category        String     @db.VarChar(255)
  subcategory     String?    @db.VarChar(255)
  code            String?    @db.VarChar(100)
  oldCode         String?    @map("old_code") @db.VarChar(100)
  frequency       String     @db.VarChar(50)
  title           String     @db.Text
  numeratorName   String?    @map("numerator_name") @db.Text
  denominatorName String?    @map("denominator_name") @db.Text
  targetRaw       String?    @map("target_raw") @db.VarChar(255)
  targetOperator  String?    @map("target_operator") @db.VarChar(10)
  targetValue     Decimal?   @map("target_value") @db.Decimal(14, 4)
  targetUnit      String?    @map("target_unit") @db.VarChar(50)
  responsibleName String?    @map("responsible_name") @db.VarChar(255)
  indicatorType   String?    @map("indicator_type") @db.VarChar(100)
  displayOrder    Int        @default(0) @map("display_order")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  topic           KpiTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  entries         KpiEntry[]
  aiAudits        KpiAiAudit[]

  @@index([topicId], map: "idx_kpi_ind_topic")
  @@index([category], map: "idx_kpi_ind_cat")
  @@index([frequency], map: "idx_kpi_ind_freq")
  @@index([responsibleName], map: "idx_kpi_ind_resp")
  @@map("kpi_indicators")
}

/// ระบบ: ติดตามตัวชี้วัด KPI โรงพยาบาล
/// หน้าเว็บ: /service/kpi-tracker
/// หน้าที่: เก็บผลลัพธ์ตัวเลขที่บันทึกรายงวด/รายเดือนของแต่ละตัวชี้วัด (ตัวตั้ง ตัวหาร ผลลัพธ์)
model KpiEntry {
  id               Int          @id @default(autoincrement())
  indicatorId      Int          @map("indicator_id")
  fiscalYear       String       @map("fiscal_year") @db.VarChar(10)
  periodKey        String       @map("period_key") @db.VarChar(50)
  periodLabel      String       @map("period_label") @db.VarChar(100)
  numeratorValue   Decimal?     @map("numerator_value") @db.Decimal(14, 4)
  denominatorValue Decimal?     @map("denominator_value") @db.Decimal(14, 4)
  resultValue      Decimal?     @map("result_value") @db.Decimal(14, 4)
  resultText       String?      @map("result_text") @db.Text
  status           String       @default("PENDING") @db.VarChar(30)
  note             String?      @db.Text
  recordedById     Int?         @map("recorded_by_id")
  recordedByName   String?      @map("recorded_by_name") @db.VarChar(255)
  recordedAt       DateTime?    @map("recorded_at") @db.DateTime(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  indicator        KpiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, periodKey], map: "uq_kpi_entry_ind_period")
  @@index([fiscalYear, periodKey], map: "idx_kpi_entry_year_period")
  @@index([status], map: "idx_kpi_entry_status")
  @@map("kpi_entries")
}

/// ระบบ: ตรวจทานตัวชี้วัด KPI ด้วย THIP 2026 + HOSxP (Zero-PHI)
/// หน้าเว็บ: /service/kpi-tracker
/// หน้าที่: เก็บผลตรวจเทียบระหว่างค่าที่คนกรอกกับค่าที่คำนวณจาก HOSxP พร้อมคำอธิบายสาเหตุ
model KpiAiAudit {
  id               Int          @id @default(autoincrement())
  indicatorId      Int          @map("indicator_id")
  fiscalYear       String       @map("fiscal_year") @db.VarChar(10)
  periodKey        String       @map("period_key") @db.VarChar(50)
  ruleCode         String       @map("rule_code") @db.VarChar(50)
  status           String       @db.VarChar(30)
  humanNumerator   Decimal?     @map("human_numerator") @db.Decimal(14, 4)
  humanDenominator Decimal?     @map("human_denominator") @db.Decimal(14, 4)
  humanResult      Decimal?     @map("human_result") @db.Decimal(14, 4)
  aiNumerator      Decimal?     @map("ai_numerator") @db.Decimal(14, 4)
  aiDenominator    Decimal?     @map("ai_denominator") @db.Decimal(14, 4)
  aiResult         Decimal?     @map("ai_result") @db.Decimal(14, 4)
  diffNumerator    Decimal?     @map("diff_numerator") @db.Decimal(14, 4)
  diffDenominator  Decimal?     @map("diff_denominator") @db.Decimal(14, 4)
  diffResult       Decimal?     @map("diff_result") @db.Decimal(14, 4)
  thipManualRef    String?      @map("thip_manual_ref") @db.VarChar(255)
  explanationTh    String?      @map("explanation_th") @db.Text
  diagnosticsJson  String?      @map("diagnostics_json") @db.LongText
  auditedAt        DateTime     @default(now()) @map("audited_at") @db.DateTime(0)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  indicator        KpiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, fiscalYear, periodKey], map: "uq_kpi_ai_audit_ind_fy_period")
  @@index([fiscalYear, periodKey, status], map: "idx_kpi_ai_audit_fy_period_status")
  @@map("kpi_ai_audits")
}

/// ระบบ: ติดตามแผนงานโครงการและงบประมาณรายไตรมาส
/// หน้าเว็บ: /service/project-tracker
/// หน้าที่: เก็บรายการโครงการ แผนงบประมาณ Q1-Q4 ยอดใช้จ่ายจริง และสถานะการส่งงาน
model ProjectTrackingRecord {
  id               Int      @id @default(autoincrement())
  fiscalYear       Int      @map("fiscal_year")
  sequenceNo       Int      @default(1) @map("sequence_no")
  projectCode      String?  @map("project_code") @db.VarChar(50)
  strategy         String   @db.VarChar(50)
  projectName      String   @map("project_name") @db.VarChar(500)
  responsibleUnit  String?  @map("responsible_unit") @db.VarChar(255)
  q1Budget         Decimal  @default(0.00) @map("q1_budget") @db.Decimal(14, 2)
  q2Budget         Decimal  @default(0.00) @map("q2_budget") @db.Decimal(14, 2)
  q3Budget         Decimal  @default(0.00) @map("q3_budget") @db.Decimal(14, 2)
  q4Budget         Decimal  @default(0.00) @map("q4_budget") @db.Decimal(14, 2)
  actualSpent      Decimal  @default(0.00) @map("actual_spent") @db.Decimal(14, 2)
  submissionStatus String   @default("ยังไม่ส่ง") @map("submission_status") @db.VarChar(50)
  budgetSource     String   @default("เงินบำรุง") @map("budget_source") @db.VarChar(50)
  notes            String?  @db.Text
  createdBy        String?  @map("created_by") @db.VarChar(100)
  updatedBy        String?  @map("updated_by") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([fiscalYear], map: "idx_pt_fiscal_year")
  @@index([strategy], map: "idx_pt_strategy")
  @@index([submissionStatus], map: "idx_pt_status")
  @@index([fiscalYear, sequenceNo], map: "idx_pt_seq")
  @@map("project_tracking_records")
}

/// ระบบ: ติดตามแผนงานโครงการและงบประมาณรายไตรมาส
/// หน้าเว็บ: /service/project-tracker
/// หน้าที่: เก็บค่า Meta/Config เสริมของระบบ Project Tracker (Key-Value)
model ProjectTrackingMeta {
  metaKey   String   @id @map("meta_key") @db.VarChar(100)
  metaValue String   @map("meta_value") @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("project_tracking_meta")
}

// =============================================================================
// 10. CLINICAL REGISTRIES (ทะเบียนผู้ป่วยเฉพาะทาง: Palliative Care & DM Remission)
// หมายเหตุ: ระบบเยี่ยมบ้าน FCT (/service/fct-home-visit) ใช้ตาราง fct_home_visits และ
//          fct_home_visit_options ซึ่งสร้างผ่าน SQL ใน fctHomeVisitService.ts
// =============================================================================

/// ระบบ: ทะเบียนผู้ป่วยประคับประคอง (Palliative Care / PC.1 / PC.3)
/// หน้าเว็บ: /service/dashboard-rcm/palliative-care, /service/dashboard-rcm/palliative-care/registry
/// หน้าที่: เก็บทะเบียนรายชื่อผู้ป่วยประคับประคอง รหัส ICD-10 วันที่ขึ้นทะเบียน และวันเสียชีวิต
model PalliativeCareRegistry {
  id                 Int       @id @default(autoincrement())
  hn                 String    @db.VarChar(20)
  patientName        String    @map("patient_name") @db.VarChar(255)
  address            String?   @db.VarChar(500)
  phone              String?   @db.VarChar(100)
  icd10Principal     String?   @map("icd10_principal") @db.VarChar(100)
  icd10Palliative    String?   @map("icd10_palliative") @db.VarChar(255)
  projectCode        String?   @map("project_code") @db.VarChar(255)
  registrationStatus String    @default("ยังไม่ได้ดำเนินการ") @map("registration_status") @db.VarChar(50)
  registeredDate     String?   @map("registered_date") @db.VarChar(20)
  visit1Date         String?   @map("visit_1_date") @db.VarChar(20)
  visit2Date         String?   @map("visit_2_date") @db.VarChar(20)
  visit3Date         String?   @map("visit_3_date") @db.VarChar(20)
  visit4Date         String?   @map("visit_4_date") @db.VarChar(20)
  visit5Date         String?   @map("visit_5_date") @db.VarChar(20)
  visit6Date         String?   @map("visit_6_date") @db.VarChar(20)
  deathDate          String?   @map("death_date") @db.VarChar(20)
  createdBy          String?   @map("created_by") @db.VarChar(100)
  updatedBy          String?   @map("updated_by") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  visits             PalliativeCareRegistryVisit[]

  @@index([hn], map: "idx_pc_hn")
  @@index([registrationStatus], map: "idx_pc_reg_status")
  @@map("palliative_care_registries")
}

/// ระบบ: ทะเบียนผู้ป่วยประคับประคอง (Palliative Care)
/// หน้าเว็บ: /service/dashboard-rcm/palliative-care/registry
/// หน้าที่: เก็บบันทึกวันที่ติดตามเยี่ยมแต่ละครั้ง (Visit No. 1..N) แบบ Normalized
model PalliativeCareRegistryVisit {
  id         Int                    @id @default(autoincrement())
  registryId Int                    @map("registry_id")
  visitNo    Int                    @map("visit_no")
  visitDate  String                 @map("visit_date") @db.VarChar(20)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  registry   PalliativeCareRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  @@unique([registryId, visitNo], map: "uq_pcrv_reg_visit")
  @@index([registryId], map: "idx_pcrv_registry_id")
  @@index([visitDate], map: "idx_pcrv_visit_date")
  @@map("palliative_care_registry_visits")
}

/// ระบบ: ทะเบียนเบาหวานเข้าสู่ระยะสงบ (DM Remission)
/// หน้าเว็บ: /service/dm-remission, /service/dm-remission/lab-tracking
/// หน้าที่: เก็บข้อมูล Cohort ผู้ป่วยเบาหวาน (1 คน ต่อ 1 ปีงบประมาณ) ค่า Lab A1c/FPG ก่อน-หลัง และผลสรุป Remission
model DmRemissionCohort {
  id                 Int       @id @default(autoincrement())
  fiscalYear         Int       @map("fiscal_year")
  pcuName            String?   @map("pcu_name") @db.VarChar(150)
  patientName        String    @map("patient_name") @db.VarChar(255)
  cid                String?   @db.VarChar(20)
  hn                 String?   @db.VarChar(20)
  age                Int?
  underlyingDiseases String?   @map("underlying_diseases") @db.VarChar(500)
  heightCm           Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightBeforeKg     Decimal?  @map("weight_before_kg") @db.Decimal(6, 2)
  weightAfterKg      Decimal?  @map("weight_after_kg") @db.Decimal(6, 2)
  waistBeforeCm      Decimal?  @map("waist_before_cm") @db.Decimal(6, 2)
  waistAfterCm       Decimal?  @map("waist_after_cm") @db.Decimal(6, 2)
  fpgBefore          Decimal?  @map("fpg_before") @db.Decimal(6, 2)
  fpgAfter           Decimal?  @map("fpg_after") @db.Decimal(6, 2)
  a1cBefore          Decimal?  @map("a1c_before") @db.Decimal(5, 2)
  a1cAfter           Decimal?  @map("a1c_after") @db.Decimal(5, 2)
  a1cPostStop3m      Decimal?  @map("a1c_post_stop_3m") @db.Decimal(5, 2)
  medsBefore         String?   @map("meds_before") @db.Text
  medsAfter          String?   @map("meds_after") @db.Text
  summaryA1c         String?   @map("summary_a1c") @db.VarChar(50)
  summaryMeds        String?   @map("summary_meds") @db.VarChar(50)
  summaryWeight      String?   @map("summary_weight") @db.VarChar(50)
  summaryWaist       String?   @map("summary_waist") @db.VarChar(50)
  summaryDiet        String?   @map("summary_diet") @db.VarChar(100)
  summaryExercise    String?   @map("summary_exercise") @db.VarChar(100)
  summaryIf          String?   @map("summary_if") @db.VarChar(100)
  summaryRemission   String?   @map("summary_remission") @db.VarChar(100)
  createdBy          String?   @map("created_by") @db.VarChar(100)
  updatedBy          String?   @map("updated_by") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([fiscalYear, hn], map: "uq_dm_remission_fy_hn")
  @@unique([fiscalYear, cid], map: "uq_dm_remission_fy_cid")
  @@index([fiscalYear], map: "idx_dm_remission_fy")
  @@index([pcuName], map: "idx_dm_remission_pcu")
  @@index([summaryRemission], map: "idx_dm_remission_status")
  @@map("dm_remission_cohorts")
}

/// ระบบ: ทะเบียนเบาหวานเข้าสู่ระยะสงบ (DM Remission)
/// หน้าเว็บ: /service/dm-remission
/// หน้าที่: เก็บตัวเลือก Dropdown ที่ Admin เพิ่ม/แก้ไขได้เอง (พฤติกรรมปรับอาหาร, ออกกำลังกาย, IF, สรุป Remission)
model DmRemissionOption {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(50)
  label     String   @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([category, label], map: "uq_dm_remission_opt_cat_label")
  @@index([category, isActive, sortOrder], map: "idx_dm_remission_opt_lookup")
  @@map("dm_remission_options")
}

// =============================================================================
// 11. ONLINE MEDIA LIBRARY (คลังสื่อออนไลน์ บน MinIO: สื่อสาธารณะ & สื่อภายในบุคลากร)
// =============================================================================

/// ระบบ: คลังสื่อออนไลน์ (Online Media Library)
/// หน้าเว็บ: /media, /member/online-media
/// หน้าที่: เก็บหมวดหมู่สื่อออนไลน์ กำหนดขอบเขตการเข้าถึงและลำดับการแสดงผล
model OnlineMediaCategory {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(200)
  slug         String            @unique(map: "uq_media_cat_slug") @db.VarChar(200)
  visibility   String            @default("ALL") @db.VarChar(20)
  displayOrder Int               @default(0) @map("display_order")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  items        OnlineMediaItem[]

  @@index([visibility, isActive, displayOrder], map: "idx_media_cat_vis_order")
  @@map("online_media_categories")
}

/// ระบบ: คลังสื่อออนไลน์ (Online Media Library)
/// หน้าเว็บ: /media, /media/[slug], /member/online-media
/// หน้าที่: เก็บรายการสื่อหลัก (วิดีโอ MinIO/YouTube, อินโฟกราฟิก, PDF) พร้อมสิทธิ์สาธารณะ/ภายในและการดาวน์โหลด
model OnlineMediaItem {
  id              Int                     @id @default(autoincrement())
  slug            String                  @unique(map: "uq_media_item_slug") @db.VarChar(255)
  title           String                  @db.VarChar(500)
  description     String?                 @db.Text
  categoryId      Int                     @map("category_id")
  visibility      String                  @default("PUBLIC") @db.VarChar(20)
  mediaType       String                  @default("VIDEO") @map("media_type") @db.VarChar(30)
  sourceType      String                  @default("MINIO") @map("source_type") @db.VarChar(20)
  s3Bucket        String?                 @map("s3_bucket") @db.VarChar(100)
  s3Key           String?                 @map("s3_key") @db.VarChar(1000)
  youtubeUrl      String?                 @map("youtube_url") @db.VarChar(500)
  thumbnailS3Key  String?                 @map("thumbnail_s3_key") @db.VarChar(1000)
  fileName        String?                 @map("file_name") @db.VarChar(255)
  fileSize        BigInt?                 @map("file_size")
  mimeType        String?                 @map("mime_type") @db.VarChar(100)
  allowDownload   Boolean                 @default(true) @map("allow_download")
  isPublished     Boolean                 @default(true) @map("is_published")
  viewCount       Int                     @default(0) @map("view_count")
  createdById     Int?                    @map("created_by_id")
  createdByName   String?                 @map("created_by_name") @db.VarChar(255)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  category        OnlineMediaCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments     OnlineMediaAttachment[]
  views           OnlineMediaView[]

  @@index([visibility, isPublished, createdAt], map: "idx_media_item_vis_pub")
  @@index([categoryId], map: "idx_media_item_cat")
  @@index([mediaType], map: "idx_media_item_type")
  @@map("online_media_items")
}

/// ระบบ: คลังสื่อออนไลน์ (เอกสาร/ภาพประกอบเพิ่มเติมในหัวข้อสื่อเดียวกัน)
/// หน้าเว็บ: /media/[slug], /member/online-media
/// หน้าที่: เก็บไฟล์แนบเสริมบน MinIO เช่น สไลด์บรรยาย เอกสาร PDF ประกอบคลิป
model OnlineMediaAttachment {
  id           Int             @id @default(autoincrement())
  mediaId      Int             @map("media_id")
  title        String          @db.VarChar(255)
  s3Bucket     String          @map("s3_bucket") @db.VarChar(100)
  s3Key        String          @map("s3_key") @db.VarChar(1000)
  fileName     String          @map("file_name") @db.VarChar(255)
  fileSize     BigInt?         @map("file_size")
  mimeType     String?         @map("mime_type") @db.VarChar(100)
  displayOrder Int             @default(0) @map("display_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamp(0)

  media        OnlineMediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, displayOrder], map: "idx_media_att_media_order")
  @@map("online_media_attachments")
}

/// ระบบ: คลังสื่อออนไลน์ (บันทึกประวัติการเข้าชมรายบุคคล)
/// หน้าเว็บ: /media/[slug], /member/online-media
/// หน้าที่: เก็บประวัติการรับชมสื่อของบุคลากรแต่ละคน (จำนวนครั้ง เวลาเข้าชมครั้งแรก และล่าสุด)
model OnlineMediaView {
  id               Int             @id @default(autoincrement())
  mediaId          Int             @map("media_id")
  memberId         Int             @map("member_id")
  memberName       String          @map("member_name") @db.VarChar(255)
  memberDepartment String?         @map("member_department") @db.VarChar(150)
  viewCount        Int             @default(1) @map("view_count")
  firstViewedAt    DateTime        @default(now()) @map("first_viewed_at") @db.Timestamp(0)
  lastViewedAt     DateTime        @default(now()) @updatedAt @map("last_viewed_at") @db.Timestamp(0)

  media            OnlineMediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([mediaId, memberId], map: "uq_media_view_media_member")
  @@index([mediaId, lastViewedAt], map: "idx_media_view_last")
  @@map("online_media_views")
}

/// ระบบ: สมุดเบอร์โทรศัพท์ภายในโรงพยาบาล
/// หน้าเว็บ: /member/internal-phones
/// หน้าที่: เก็บข้อมูลอาคาร ชั้น ห้อง/หน่วยงาน เบอร์โทรภายใน และหมายเหตุ สำหรับค้นหาและจัดการ
model HospitalInternalPhone {
  id           Int      @id @default(autoincrement())
  building     String   @db.VarChar(150)
  floor        String?  @db.VarChar(50)
  room         String   @db.VarChar(255)
  phone        String   @default("") @db.VarChar(100)
  note         String?  @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.VarChar(100)
  updatedBy    String?  @map("updated_by") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([building, floor], map: "idx_internal_phone_building_floor")
  @@index([isActive, displayOrder], map: "idx_internal_phone_active_order")
  @@map("hospital_internal_phones")
}
