generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique(map: "username") @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  email        String   @db.VarChar(100)
  role         Role?    @default(admin)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  @@map("users")
}

model News {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(255)
  slug        String       @unique(map: "slug") @db.VarChar(255)
  category    String       @db.VarChar(100)
  youtubeLink String?      @map("youtube_link") @db.VarChar(255)
  startDate   DateTime     @map("start_date") @db.DateTime(0)
  endDate     DateTime     @map("end_date") @db.DateTime(0)
  viewCount   Int?         @default(0) @map("view_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamp(0)
  attachments Attachment[]

  @@index([category], map: "idx_category")
  @@index([startDate, endDate], map: "idx_dates")
  @@map("news")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  newsId       Int      @map("news_id")
  filePath     String   @map("file_path") @db.VarChar(255)
  fileType     String?  @map("file_type") @db.VarChar(50)
  originalName String?  @map("original_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  news         News     @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attachments_ibfk_1")

  @@index([newsId], map: "news_id")
  @@map("attachments")
}

enum Role {
  admin
  editor
  patient
  doctor
  nurse
  hr
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  imagePath    String   @map("image_path") @db.VarChar(255)
  title        String?  @db.VarChar(255)
  linkUrl      String?  @map("link_url") @db.VarChar(255)
  startDate    DateTime @map("start_date") @db.DateTime(0)
  endDate      DateTime @map("end_date") @db.DateTime(0)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  @@map("hero_slides")
}
