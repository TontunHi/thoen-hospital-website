generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model News {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(500)
  slug        String       @unique(map: "slug") @db.VarChar(255)
  category    String       @db.VarChar(100)
  youtubeLink String?      @map("youtube_link") @db.VarChar(255)
  startDate   DateTime     @map("start_date") @db.DateTime(0)
  endDate     DateTime     @map("end_date") @db.DateTime(0)
  viewCount   Int?         @default(0) @map("view_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamp(0)
  attachments Attachment[]

  @@index([category], map: "idx_category")
  @@index([startDate, endDate], map: "idx_dates")
  @@map("news")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  newsId       Int      @map("news_id")
  filePath     String   @map("file_path") @db.VarChar(1000)
  fileType     String?  @map("file_type") @db.VarChar(50)
  originalName String?  @map("original_name") @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  news         News     @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attachments_ibfk_1")

  @@index([newsId], map: "news_id")
  @@map("attachments")
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  imagePath    String   @map("image_path") @db.VarChar(255)
  title        String?  @db.VarChar(255)
  linkUrl      String?  @map("link_url") @db.VarChar(255)
  startDate    DateTime @map("start_date") @db.DateTime(0)
  endDate      DateTime @map("end_date") @db.DateTime(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)
  displayOrder Int      @default(0) @map("display_order")
  duration     Int      @default(6) @map("duration")

  @@map("hero_slides")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now()) @db.Timestamp(0)
  username      String?  @db.VarChar(100)
  email         String?  @db.VarChar(100)
  actionType    String   @map("action_type") @db.VarChar(50)
  targetTable   String?  @map("target_table") @db.VarChar(100)
  actionDetails String?  @map("action_details") @db.Text
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)

  @@index([username], map: "idx_username")
  @@index([actionType], map: "idx_action_type")
  @@index([timestamp], map: "idx_timestamp")
  @@map("audit_logs")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([createdAt], map: "idx_contact_created")
  @@map("contact_messages")
}

model Member {
  id                       Int                        @id @default(autoincrement())
  username                 String                     @unique(map: "username") @db.VarChar(100)
  email                    String                     @unique(map: "email") @db.VarChar(100)
  name                     String?                    @db.VarChar(255)
  department               String?                    @db.VarChar(100)
  salaryUser               String?                    @map("salary_user") @db.VarChar(100)
  salaryPass               String?                    @map("salary_pass") @db.VarChar(100)
  role                     String                     @default("member") @db.VarChar(50)
  otpCode                  String?                    @map("otp_code") @db.VarChar(10)
  otpExpiry                DateTime?                  @map("otp_expiry") @db.DateTime(0)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  profilePath              String?                    @map("profile_path") @db.VarChar(255)
  position                 String?                    @db.VarChar(100)
  signaturePath            String?                    @map("signature_path") @db.VarChar(255)
  ita_blogs                ita_blogs[]
  member_telegram_links    member_telegram_links?
  telegram_link_challenges telegram_link_challenges[]
  hospital_assets          HospitalAsset[]
  member_permissions       MemberPermission[]
  eventsHeadOrganized      HospitalEvent[]            @relation("EventHeadOrganizer")
  eventOrganizers          EventOrganizer[]
  eventRegistrations       EventRegistration[]
  eventAttendances         EventAttendance[]
  eventAttachments         EventAttachment[]

  @@map("members")
}

model MemberSystemSetting {
  configKey   String @id @map("config_key") @db.VarChar(100)
  configValue String @map("config_value") @db.VarChar(255)

  @@map("member_system_settings")
}

model PositionPermission {
  id            Int      @id @default(autoincrement())
  permissionKey String   @map("permission_key") @db.VarChar(100)
  positionName  String   @map("position_name") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@unique([permissionKey, positionName], map: "uq_permission_position")
  @@map("position_permissions")
}

model MemberPermission {
  id            Int      @id @default(autoincrement())
  memberId      Int      @map("member_id")
  permissionKey String   @map("permission_key") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  createdBy     String?  @map("created_by") @db.VarChar(100)

  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionKey], map: "uq_member_permission")
  @@index([memberId], map: "idx_member_perm_id")
  @@index([permissionKey], map: "idx_member_perm_key")
  @@map("member_permissions")
}

model ita_blogs {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(500)
  slug            String?  @db.VarChar(500)
  content         String   @db.LongText
  author_id       Int
  author_name     String?  @db.VarChar(255)
  author_position String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
  members         Member   @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ita_blogs_ibfk_1")

  @@index([author_id], map: "author_id")
}

model member_telegram_links {
  id                BigInt   @id @default(autoincrement())
  member_id         Int      @unique(map: "member_id")
  telegram_chat_id  BigInt   @unique(map: "telegram_chat_id")
  telegram_user_id  BigInt   @unique(map: "telegram_user_id")
  telegram_username String?  @db.VarChar(100)
  first_name        String?  @db.VarChar(150)
  linked_at         DateTime @default(now()) @db.DateTime(0)
  updated_at        DateTime @default(now()) @db.DateTime(0)
  members           Member   @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "member_telegram_links_ibfk_1")

  @@index([telegram_chat_id], map: "idx_chat_id")
  @@index([member_id], map: "idx_member_id")
}

model rdu_files {
  id            Int         @id @default(autoincrement())
  folder_id     Int
  display_name  String      @db.VarChar(255)
  file_name     String      @db.VarChar(255)
  file_path     String      @db.VarChar(500)
  file_size     BigInt?
  display_order Int         @default(0)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  rdu_folders   rdu_folders @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "rdu_files_ibfk_1")

  @@index([folder_id], map: "folder_id")
}

model rdu_folders {
  id            Int         @id @default(autoincrement())
  folder_name   String      @unique(map: "folder_name") @db.VarChar(255)
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  rdu_files     rdu_files[]
}

model telegram_link_challenges {
  id         BigInt    @id @default(autoincrement())
  member_id  Int
  token_hash String    @unique(map: "token_hash") @db.VarChar(64)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  members    Member    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "telegram_link_challenges_ibfk_1")

  @@index([token_hash, expires_at], map: "idx_token_lookup")
  @@index([member_id], map: "member_id")
}


model OutgoingDocument {
  id           Int      @id @default(autoincrement())
  year         String   @db.VarChar(10)
  label        String   @db.VarChar(255)
  note         String?  @db.VarChar(500)
  url          String   @db.VarChar(1000)
  status       String   @default("เสร็จสิ้น") @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by") @db.VarChar(100)
  updatedBy    String?  @map("updated_by") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([year], map: "idx_outgoing_doc_year")
  @@index([isActive], map: "idx_outgoing_doc_active")
  @@map("outgoing_documents")
}

model EthicsYear {
  id           Int              @id @default(autoincrement())
  year         String           @unique(map: "uq_ethics_year") @db.VarChar(10)
  displayOrder Int              @default(0) @map("display_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  documents    EthicsDocument[]

  @@index([displayOrder], map: "idx_ethics_year_order")
  @@map("ethics_years")
}

model EthicsDocument {
  id           Int              @id @default(autoincrement())
  yearId       Int              @map("year_id")
  parentId     Int?             @map("parent_id")
  title        String           @db.VarChar(500)
  filePath     String?          @map("file_path") @db.VarChar(1000)
  fileSize     BigInt?          @map("file_size")
  displayOrder Int              @default(0) @map("display_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  year         EthicsYear       @relation(fields: [yearId], references: [id], onDelete: Cascade)
  parent       EthicsDocument?  @relation("EthicsSubDocuments", fields: [parentId], references: [id], onDelete: Cascade)
  children     EthicsDocument[] @relation("EthicsSubDocuments")

  @@index([yearId], map: "idx_ethics_doc_year")
  @@index([parentId], map: "idx_ethics_doc_parent")
  @@map("ethics_documents")
}

model Task {
  id              String         @id @default(uuid()) @db.VarChar(36)
  taskNo          String         @unique(map: "uq_task_no") @map("task_no") @db.VarChar(50)
  taskType        String         @map("task_type") @db.VarChar(50)
  title           String         @db.VarChar(500)
  description     String?        @db.Text
  urgency         String         @default("NORMAL") @db.VarChar(20)
  
  requesterId     Int            @map("requester_id")
  requesterName   String         @map("requester_name") @db.VarChar(255)
  requesterDept   String?        @map("requester_dept") @db.VarChar(100)
  
  status          String         @default("PENDING") @db.VarChar(30)
  currentStepNo   Int            @default(1) @map("current_step_no")
  currentAssignee Int?           @map("current_assignee")
  currentRole     String?        @map("current_role") @db.VarChar(100)

  referenceId     String?        @map("reference_id") @db.VarChar(100)
  customPayload   String?        @map("custom_payload") @db.LongText

  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  steps           TaskStep[]
  auditLogs       TaskAuditLog[]
  repairDetail    RepairDetail?

  @@index([currentAssignee, status], map: "idx_task_assignee_status")
  @@index([taskType, status], map: "idx_task_type_status")
  @@index([requesterId], map: "idx_task_requester")
  @@map("inbox_tasks")
}

model TaskStep {
  id             String         @id @default(uuid()) @db.VarChar(36)
  taskId         String         @map("task_id") @db.VarChar(36)
  stepNo         Int            @map("step_no")
  stepName       String         @map("step_name") @db.VarChar(255)
  
  assigneeType   String         @default("INDIVIDUAL") @map("assignee_type") @db.VarChar(30)
  assignedToId   Int?           @map("assigned_to_id")
  assignedRole   String?        @map("assigned_role") @db.VarChar(100)
  
  status         String         @default("WAITING") @db.VarChar(30)
  
  actionTaken    String?        @map("action_taken") @db.VarChar(50)
  actionBy       Int?           @map("action_by")
  actionByName   String?        @map("action_by_name") @db.VarChar(255)
  actionAt       DateTime?      @map("action_at") @db.DateTime(0)
  comment        String?        @db.Text
  
  signaturePath  String?        @map("signature_path") @db.VarChar(255)
  signatureHash  String?        @map("signature_hash") @db.VarChar(64)

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepNo], map: "uq_task_step_no")
  @@index([assignedToId, status], map: "idx_step_assignee_status")
  @@map("inbox_task_steps")
}

model TaskAuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  taskId      String   @map("task_id") @db.VarChar(36)
  action      String   @db.VarChar(50)
  performedBy Int      @map("performed_by")
  performerName String? @map("performer_name") @db.VarChar(255)
  details     String?  @db.LongText
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "idx_audit_task_id")
  @@map("inbox_task_audit_logs")
}

model HospitalLocation {
  id           Int      @id @map("id") // LEVEL_ROOM_ID from Gotowin
  roomName     String   @map("room_name") @db.VarChar(200)
  floorId      Int      @map("floor_id")
  floorName    String   @map("floor_name") @db.VarChar(50)
  buildingId   Int      @map("building_id")
  buildingName String   @map("building_name") @db.VarChar(200)
  fullName     String   @map("full_name") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  hospital_assets HospitalAsset[]

  @@index([buildingId, floorId], map: "idx_loc_building_floor")
  @@index([roomName], map: "idx_loc_room_name")
  @@map("hospital_locations")
}

model RepairDetail {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  taskId                String   @unique(map: "uq_repair_task_id") @map("task_id") @db.VarChar(36)
  repairType            String   @map("repair_type") @db.VarChar(50)
  itemCategory          String   @default("EQUIPMENT") @map("item_category") @db.VarChar(30)
  equipmentNumber       String?  @map("equipment_number") @db.VarChar(100)
  equipmentName         String?  @map("equipment_name") @db.VarChar(255)
  nonEquipmentItem      String?  @map("non_equipment_item") @db.VarChar(255)
  locationId            Int?     @map("location_id")
  locationFullName      String   @map("location_full_name") @db.VarChar(500)
  symptomDetail         String   @map("symptom_detail") @db.Text
  assignedTechnicianId  Int?     @map("assigned_technician_id")
  assignedTechnicianName String? @map("assigned_technician_name") @db.VarChar(255)
  coWorkers             Json?    @map("co_workers")
  repairNature          String   @default("NORMAL") @map("repair_nature") @db.VarChar(50)
  repairStatus          String   @default("WAITING") @map("repair_status") @db.VarChar(50)
  isExternalRepair      Boolean  @default(false) @map("is_external_repair")
  externalVendorName    String?  @map("external_vendor_name") @db.VarChar(255)
  externalReason        String?  @map("external_reason") @db.Text
  costType              String   @default("NO_COST") @map("cost_type") @db.VarChar(30)
  costAmount            Decimal? @map("cost_amount") @db.Decimal(10, 2)
  foundProblem          String?  @map("found_problem") @db.Text
  solutionStep          String?  @map("solution_step") @db.Text
  photos                Json?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  task                  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([repairType], map: "idx_repair_type")
  @@index([repairStatus], map: "idx_repair_status")
  @@map("repair_details")
}

model HospitalAsset {
  id                Int               @id @default(autoincrement())
  articleNum        String            @unique(map: "uq_asset_article_num") @map("article_num") @db.VarChar(100)
  fsnNum            String?           @map("fsn_num") @db.VarChar(50)
  name              String            @map("name") @db.VarChar(255)
  brand             String?           @map("brand") @db.VarChar(100)
  model             String?           @map("model") @db.VarChar(100)
  serialNo          String?           @map("serial_no") @db.VarChar(100)
  category          String            @default("GENERAL") @map("category") @db.VarChar(30)
  
  locationId        Int?              @map("location_id")
  locationFullName  String?           @map("location_full_name") @db.VarChar(500)
  department        String?           @map("department") @db.VarChar(100)
  custodianId       Int?              @map("custodian_id")
  
  receivedDate      DateTime?         @map("received_date") @db.Date
  warrantyStartDate DateTime?         @map("warranty_start_date") @db.Date
  warrantyEndDate   DateTime?         @map("warranty_end_date") @db.Date
  expireDate        DateTime?         @map("expire_date") @db.Date
  
  price             Decimal?          @map("price") @db.Decimal(12, 2)
  vendorName        String?           @map("vendor_name") @db.VarChar(255)
  vendorContact     String?           @map("vendor_contact") @db.VarChar(255)
  contractNo        String?           @map("contract_no") @db.VarChar(100)
  
  status            String            @default("ACTIVE") @map("status") @db.VarChar(30)
  isLoanable        Boolean           @default(false) @map("is_loanable")
  imageUrl          String?           @map("image_url") @db.VarChar(500)
  notes             String?           @map("notes") @db.Text
  
  gtwArticleId      Int?              @map("gtw_article_id")
  
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  custodian         Member?           @relation(fields: [custodianId], references: [id], onDelete: SetNull)
  location          HospitalLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  borrowItems       EquipmentBorrowItem[]

  @@index([category], map: "idx_asset_category")
  @@index([status], map: "idx_asset_status")
  @@index([isLoanable], map: "idx_asset_is_loanable")
  @@index([department], map: "idx_asset_department")
  @@index([locationId], map: "idx_asset_location")
  @@index([warrantyEndDate], map: "idx_asset_warranty")
  @@map("hospital_assets")
}


/// คำขอสมัคร (Registration): ข้อมูลที่บุคลากรส่งผ่าน /register รอ admin อนุมัติ
/// แยกจาก members เพราะ members คือบัญชีที่ล็อกอินได้แล้ว
model MemberRegistration {
  id                  Int       @id @default(autoincrement())
  citizenId           String    @map("citizen_id") @db.VarChar(13)
  title               String    @db.VarChar(50)
  firstNameTh         String    @map("first_name_th") @db.VarChar(100)
  lastNameTh          String    @map("last_name_th") @db.VarChar(100)
  firstNameEn         String    @map("first_name_en") @db.VarChar(100)
  lastNameEn          String    @map("last_name_en") @db.VarChar(100)
  nickname            String    @db.VarChar(50)
  licenseNo           String?   @map("license_no") @db.VarChar(100)
  birthDate           String    @map("birth_date") @db.VarChar(50)
  startDate           String    @map("start_date") @db.VarChar(50)
  containDate         String?   @map("contain_date") @db.VarChar(50)
  department          String    @db.VarChar(150)
  position            String    @db.VarChar(150)
  level               String    @db.VarChar(100)
  personnelGroup      String    @map("personnel_group") @db.VarChar(100)
  personnelGroupOther String?   @map("personnel_group_other") @db.VarChar(150)
  hasHosxp            Boolean   @default(false) @map("has_hosxp")
  hosxpUser           String?   @map("hosxp_user") @db.VarChar(100)
  hosxpPass           String?   @map("hosxp_pass") @db.VarChar(255)
  email               String    @db.VarChar(100)
  phone               String    @db.VarChar(50)
  lineId              String?   @map("line_id") @db.VarChar(100)
  inHospitalHousing   Boolean   @default(false) @map("in_hospital_housing")
  housingLocation     String?   @map("housing_location") @db.VarChar(100)
  hasVehicle          Boolean   @default(false) @map("has_vehicle")
  vehicles            Json?
  status              String    @default("pending") @db.VarChar(20)
  rejectReason        String?   @map("reject_reason") @db.Text
  approvedAt          DateTime? @map("approved_at") @db.Timestamp(0)
  approvedBy          String?   @map("approved_by") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([citizenId], map: "idx_registration_citizen")
  @@index([status], map: "idx_registration_status")
  @@index([email], map: "idx_registration_email")
  @@map("member_registrations")
}

model HospitalMaterial {
  id           Int                   @id @default(autoincrement())
  name         String                @db.VarChar(255)
  category     String                @default("GENERAL") @db.VarChar(50)
  materialType String                @default("REUSABLE") @map("material_type") @db.VarChar(30)
  totalQty     Int                   @default(0) @map("total_qty")
  availableQty Int                   @default(0) @map("available_qty")
  unit         String                @default("ชิ้น") @db.VarChar(50)
  location     String?               @db.VarChar(255)
  imageUrl     String?               @map("image_url") @db.VarChar(500)
  notes        String?               @db.Text
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  borrowItems  EquipmentBorrowItem[]

  @@index([category], map: "idx_material_category")
  @@index([materialType], map: "idx_material_type")
  @@index([isActive], map: "idx_material_is_active")
  @@map("hospital_materials")
}

model EquipmentBorrowRequest {
  id                 Int                   @id @default(autoincrement())
  requestNo          String                @unique(map: "uq_borrow_request_no") @map("request_no") @db.VarChar(50)
  requesterId        Int                   @map("requester_id")
  requesterName      String                @map("requester_name") @db.VarChar(255)
  requesterDept      String?               @map("requester_dept") @db.VarChar(150)
  purpose            String                @db.Text
  location           String?               @db.VarChar(255)
  borrowDate         DateTime              @map("borrow_date") @db.Date
  expectedReturnDate DateTime?             @map("expected_return_date") @db.Date
  actualReturnDate   DateTime?             @map("actual_return_date") @db.DateTime(0)
  phone              String?               @db.VarChar(50)
  notes              String?               @db.Text
  status             String                @default("PENDING") @db.VarChar(30)
  approvedById       Int?                  @map("approved_by_id")
  approvedByName     String?               @map("approved_by_name") @db.VarChar(255)
  approvedAt         DateTime?             @map("approved_at") @db.DateTime(0)
  rejectReason       String?               @map("reject_reason") @db.Text
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  items              EquipmentBorrowItem[]
  events             HospitalEvent[]

  @@index([requesterId], map: "idx_borrow_requester")
  @@index([status], map: "idx_borrow_status")
  @@index([borrowDate], map: "idx_borrow_date")
  @@index([expectedReturnDate], map: "idx_borrow_expected_return")
  @@map("equipment_borrow_requests")
}

model EquipmentBorrowItem {
  id              Int                    @id @default(autoincrement())
  requestId       Int                    @map("request_id")
  itemType        String                 @map("item_type") @db.VarChar(20)
  assetId         Int?                   @map("asset_id")
  materialId      Int?                   @map("material_id")
  itemName        String                 @map("item_name") @db.VarChar(255)
  itemCode        String?                @map("item_code") @db.VarChar(100)
  quantity        Int                    @default(1)
  returnedQty     Int                    @default(0) @map("returned_qty")
  status          String                 @default("BORROWED") @db.VarChar(30)
  returnCondition String?                @map("return_condition") @db.VarChar(30)
  returnNotes     String?                @map("return_notes") @db.Text
  returnedAt      DateTime?              @map("returned_at") @db.DateTime(0)
  inspectedById   Int?                   @map("inspected_by_id")
  inspectedByName String?                @map("inspected_by_name") @db.VarChar(255)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  request         EquipmentBorrowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset           HospitalAsset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  material        HospitalMaterial?      @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([requestId], map: "idx_item_request_id")
  @@index([assetId], map: "idx_item_asset_id")
  @@index([materialId], map: "idx_item_material_id")
  @@index([status], map: "idx_item_status")
  @@map("equipment_borrow_items")
}

model HospitalEvent {
  id               Int                   @id @default(autoincrement())
  title            String                @db.VarChar(500)
  description      String?               @db.Text
  location         String?               @db.VarChar(255)
  bannerUrl        String?               @map("banner_url") @db.VarChar(500)
  
  eventStartDate   DateTime              @map("event_start_date") @db.DateTime(0)
  eventEndDate     DateTime              @map("event_end_date") @db.DateTime(0)
  checkinOpenTime  DateTime              @map("checkin_open_time") @db.DateTime(0)
  checkinCloseTime DateTime              @map("checkin_close_time") @db.DateTime(0)
  
  headOrganizerId  Int                   @map("head_organizer_id")
  borrowRequestId  Int?                  @map("borrow_request_id")
  qrToken          String                @unique(map: "uq_event_qr_token") @map("qr_token") @db.VarChar(64)
  fiscalYear       String                @default("2570") @map("fiscal_year") @db.VarChar(10)
  status           String                @default("UPCOMING") @db.VarChar(30)
  
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  headOrganizer    Member                @relation("EventHeadOrganizer", fields: [headOrganizerId], references: [id])
  borrowRequest    EquipmentBorrowRequest? @relation(fields: [borrowRequestId], references: [id], onDelete: SetNull)
  coOrganizers     EventOrganizer[]
  registrations    EventRegistration[]
  attendances      EventAttendance[]
  attachments      EventAttachment[]

  @@index([fiscalYear, status], map: "idx_event_year_status")
  @@index([eventStartDate], map: "idx_event_start_date")
  @@index([headOrganizerId], map: "idx_event_head_organizer")
  @@map("hospital_events")
}

model EventOrganizer {
  id        Int           @id @default(autoincrement())
  eventId   Int           @map("event_id")
  memberId  Int           @map("member_id")
  roleTitle String?       @default("ผู้รับผิดชอบร่วม") @map("role_title") @db.VarChar(100)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(0)

  event     HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_organizer")
  @@index([memberId], map: "idx_event_org_member")
  @@map("event_organizers")
}

model EventRegistration {
  id           Int           @id @default(autoincrement())
  eventId      Int           @map("event_id")
  memberId     Int           @map("member_id")
  registeredAt DateTime      @default(now()) @map("registered_at") @db.Timestamp(0)

  event        HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_registration")
  @@index([memberId], map: "idx_event_reg_member")
  @@map("event_registrations")
}

model EventAttendance {
  id            Int           @id @default(autoincrement())
  eventId       Int           @map("event_id")
  memberId      Int           @map("member_id")
  citizenId     String        @map("citizen_id") @db.VarChar(13)
  checkedInAt   DateTime      @default(now()) @map("checked_in_at") @db.Timestamp(0)
  pointsAwarded Int           @default(1) @map("points_awarded")

  event         HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId], map: "uq_event_attendance")
  @@index([checkedInAt], map: "idx_attendance_time")
  @@index([memberId], map: "idx_attendance_member")
  @@map("event_attendances")
}

model EventAttachment {
  id                 Int           @id @default(autoincrement())
  eventId            Int           @map("event_id")
  attachmentType     String        @map("attachment_type") @db.VarChar(20)
  title              String        @db.VarChar(255)
  filePath           String?       @map("file_path") @db.VarChar(1000)
  fileType           String?       @map("file_type") @db.VarChar(100)
  fileSize           BigInt?       @map("file_size")
  textContent        String?       @map("text_content") @db.Text
  uploadedByMemberId Int?          @map("uploaded_by_member_id")
  displayOrder       Int           @default(0) @map("display_order")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  event              HospitalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy         Member?       @relation(fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  @@index([eventId], map: "idx_event_attachment_event")
  @@index([attachmentType], map: "idx_event_attachment_type")
  @@index([uploadedByMemberId], map: "idx_event_attachment_uploader")
  @@map("event_attachments")
}

model ScreeningQueue {
  id          Int      @id @default(autoincrement())
  cid         String   @db.VarChar(13)
  title       String?  @db.VarChar(50)
  firstName   String?  @map("first_name") @db.VarChar(100)
  lastName    String?  @map("last_name") @db.VarChar(100)
  fullName    String   @map("full_name") @db.VarChar(255)
  gender      String?  @db.VarChar(10)
  birthDate   String?  @map("birth_date") @db.VarChar(20)
  address     String?  @db.Text
  photoBase64 String?  @map("photo_base64") @db.LongText
  rawPayload  String?  @map("raw_payload") @db.LongText
  status      String   @default("WAITING") @db.VarChar(30)
  vn          String?  @db.VarChar(50)
  recordedBy  Int?     @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([createdAt], map: "idx_screening_created")
  @@index([cid], map: "idx_screening_cid")
  @@index([status], map: "idx_screening_status")
  @@map("screening_queues")
}

model KpiTopic {
  id          Int            @id @default(autoincrement())
  fiscalYear  String         @map("fiscal_year") @db.VarChar(10)
  code        String         @db.VarChar(100)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  indicators  KpiIndicator[]

  @@unique([fiscalYear, code], map: "uq_kpi_topic_year_code")
  @@index([fiscalYear], map: "idx_kpi_topic_year")
  @@map("kpi_topics")
}

model KpiIndicator {
  id              Int        @id @default(autoincrement())
  topicId         Int        @map("topic_id")
  sequence        String?    @db.VarChar(50)
  category        String     @db.VarChar(255)
  subcategory     String?    @db.VarChar(255)
  code            String?    @db.VarChar(100)
  oldCode         String?    @map("old_code") @db.VarChar(100)
  frequency       String     @db.VarChar(50)
  title           String     @db.Text
  numeratorName   String?    @map("numerator_name") @db.Text
  denominatorName String?    @map("denominator_name") @db.Text
  targetRaw       String?    @map("target_raw") @db.VarChar(255)
  targetOperator  String?    @map("target_operator") @db.VarChar(10)
  targetValue     Decimal?   @map("target_value") @db.Decimal(14, 4)
  targetUnit      String?    @map("target_unit") @db.VarChar(50)
  responsibleName String?    @map("responsible_name") @db.VarChar(255)
  indicatorType   String?    @map("indicator_type") @db.VarChar(100)
  displayOrder    Int        @default(0) @map("display_order")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  topic           KpiTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  entries         KpiEntry[]

  @@index([topicId], map: "idx_kpi_ind_topic")
  @@index([category], map: "idx_kpi_ind_cat")
  @@index([frequency], map: "idx_kpi_ind_freq")
  @@index([responsibleName], map: "idx_kpi_ind_resp")
  @@map("kpi_indicators")
}

model KpiEntry {
  id               Int          @id @default(autoincrement())
  indicatorId      Int          @map("indicator_id")
  fiscalYear       String       @map("fiscal_year") @db.VarChar(10)
  periodKey        String       @map("period_key") @db.VarChar(50)
  periodLabel      String       @map("period_label") @db.VarChar(100)
  numeratorValue   Decimal?     @map("numerator_value") @db.Decimal(14, 4)
  denominatorValue Decimal?     @map("denominator_value") @db.Decimal(14, 4)
  resultValue      Decimal?     @map("result_value") @db.Decimal(14, 4)
  resultText       String?      @map("result_text") @db.Text
  status           String       @default("PENDING") @db.VarChar(30)
  note             String?      @db.Text
  recordedById     Int?         @map("recorded_by_id")
  recordedByName   String?      @map("recorded_by_name") @db.VarChar(255)
  recordedAt       DateTime?    @map("recorded_at") @db.DateTime(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  indicator        KpiIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, periodKey], map: "uq_kpi_entry_ind_period")
  @@index([fiscalYear, periodKey], map: "idx_kpi_entry_year_period")
  @@index([status], map: "idx_kpi_entry_status")
  @@map("kpi_entries")
}


