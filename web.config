<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering allowDoubleEscaping="true" />
        </security>

        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>

        <rewrite>
            <rules>
                <!-- 1. Assets needed by Maintenance Page: allow images & fonts to be served directly from public/ -->
                <rule name="MaintenanceStaticAssets" stopProcessing="true">
                    <match url="^(images|fonts)/(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{DOCUMENT_ROOT}\maintenance.flag" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:0}" />
                </rule>

                <!-- 2. API requests during maintenance: return maintenance.json -->
                <rule name="MaintenanceModeApi" stopProcessing="true">
                    <match url="^api/(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{DOCUMENT_ROOT}\maintenance.flag" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="public/maintenance.json" />
                </rule>

                <!-- 3. JSON Accept Header requests during maintenance: return maintenance.json -->
                <rule name="MaintenanceModeJsonAccept" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{DOCUMENT_ROOT}\maintenance.flag" matchType="IsFile" />
                        <add input="{HTTP_ACCEPT}" pattern="application/json" />
                    </conditions>
                    <action type="Rewrite" url="public/maintenance.json" />
                </rule>

                <!-- 4. Web page requests during maintenance: return maintenance.html -->
                <rule name="MaintenanceModeHtml" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{DOCUMENT_ROOT}\maintenance.flag" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="public/maintenance.html" />
                </rule>

                <!-- 5. Default: Reverse Proxy to Next.js production server on port 6060 -->
                <rule name="ReverseProxyToNextJS" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:6060/{R:1}" appendQueryString="true" />
                    <serverVariables>
                        <set name="HTTP_HOST" value="{HTTP_HOST}" />
                        <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                    </serverVariables>
                </rule>
            </rules>
        </rewrite>

        <!-- Fallback if PM2 is stopped (connection failure 502/503 from ARR) -->
        <httpErrors errorMode="Custom" existingResponse="Auto">
            <remove statusCode="502" subStatusCode="-1" />
            <remove statusCode="503" subStatusCode="-1" />
            <error statusCode="502" path="public\maintenance.html" responseMode="File" />
            <error statusCode="503" path="public\maintenance.html" responseMode="File" />
        </httpErrors>
    </system.webServer>
</configuration>
